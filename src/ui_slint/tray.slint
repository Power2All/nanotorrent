// Notification-area icon and its right-click menu.
//
import { L } from "globals.slint";
// SystemTrayIcon is a top-level component in its own right, not something that
// can sit inside a Window - hence a second .slint file, re-exported from
// app.slint so one compile pass generates both. Slint talks to
// Shell_NotifyIcon on Windows, NSStatusItem on macOS and StatusNotifierItem on
// Linux, so no extra crate is involved.

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../../res/app.png");
    title: "NanoTorrent";

    /// Current transfer rates, set from the refresh tick. Empty until the
    /// first one runs, which is why the tooltip falls back to the bare name.
    in property <string> rates;

    // A binding, not a value Rust writes: assigning to a property that already
    // has a literal binding panics inside Slint ("Constant property being
    // changed"). Rust sets `rates` instead and this follows it.
    //
    // One line rather than two: Windows puts this in NOTIFYICONDATA.szTip,
    // which is a single short string, so a newline would not help there.
    tooltip: root.rates == "" ? "NanoTorrent" : "NanoTorrent - " + root.rates;

    callback show-window();
    callback exit();

    // Left-click opens the window on Windows and Linux; on macOS AppKit pops
    // the menu instead, which is why "NanoTorrent" is also a menu entry.
    clicked => { root.show-window(); }

    Menu {
        MenuItem { title: L.s(L.revision, "tray_open"); activated => { root.show-window(); } }
        MenuSeparator { }
        MenuItem { title: L.s(L.revision, "amp_exit"); activated => { root.exit(); } }
    }
}
