// NanoTorrent's cross-platform UI.
//
// Grown from spike/slint-list, which worked the shape out the hard way; that
// README records the traps and the ones that bite here are marked in place.
//
// The list is a custom row over ListView rather than StandardTableView, which
// can do neither of the two things it must: its only selection property is
// `current-row: int` (no multi-select, and multi-select drives the context
// menu), and its cells are StandardListViewItem, which renders text and so
// could never draw the Progress bar.
//
// The layout this was matched against is captured in docs/ui-baseline/.

import { Clip, L } from "globals.slint";
export { Clip, L }

import { PreferencesDialog } from "preferences.slint";
import { CliHelpDialog } from "clihelp.slint";
import { UpdateDialog } from "update.slint";
import { AboutDialog } from "about.slint";
import { CreateTorrentDialog } from "create.slint";
import { ClosePromptDialog } from "closeprompt.slint";
import { RemoveDialog } from "remove.slint";
import { PluginWindow, PluginRowItem, PluginButton } from "plugin.slint";
export { PreferencesDialog, AboutDialog, CliHelpDialog, UpdateDialog, CreateTorrentDialog, ClosePromptDialog, RemoveDialog }
export { PluginWindow, PluginRowItem, PluginButton }

import { ScrollView, ListView, Button, HorizontalBox, VerticalBox, TabWidget, TextEdit, LineEdit, CheckBox, Palette } from "std-widgets.slint";

// Re-exported so a single slint_build::compile pass generates it alongside the
// window: SystemTrayIcon cannot live inside a Window, but it can share a module.
import { Tray } from "tray.slint";
export { Tray }

export struct FileEntryRow {
    /// Index into the torrent's file list, or -1 for a folder row.
    index: int,
    /// Nesting level, drawn as indentation - Slint has no tree widget.
    depth: int,
    name: string,
    size: string,
    progress: float,
    included: bool,
}

export struct PeerEntryRow {
    addr: string,
    /// Empty when GeoIP has no answer, or there is no artwork for the country.
    flag: image,
    country: string,
    status: string,
    downloaded: string,
    pieces: string,
}

export struct TrackerEntryRow {
    url: string,
    status: string,
    seeds: string,
    leeches: string,
    fails: string,
    next-announce: string,
    indented: bool,
}

export struct Row {
    name: string,
    queue: string,
    size: string,
    remaining: string,
    status: string,
    progress: float,          // 0..1, drawn as a bar rather than printed
    eta: string,
    dl: string,
    ul: string,
    availability: string,
    ratio: string,
    seeds: string,
    peers: string,
    added: string,
    completed: string,
    label: string,
    selected: bool,
}

// One place for the column widths, so the header and the rows cannot drift.
// Column widths and captions, both computed in Rust.
//
// Widths are not fixed: a translated caption can be much longer than the
// English one ("Completed on" is "Voltooid op" in Dutch but far longer in
// others), so each column is widened to fit its own header. `total` is the sum
// of them - it used to be a hand-written constant, and it had drifted 100px
// short of the real total, which left the last column outside the painted row
// background and showing through as black.
export global Cols {
    // in-out, not in: Rust computes the starting widths, and the header's
    // drag handles write them back. `total` is kept in step by hand rather
    // than summed, because Slint has no fold over a model - and it drives the
    // ScrollView's viewport, so letting it drift would leave the last column
    // outside the painted row background, which is exactly how the
    // hand-written constant it replaced went wrong.
    in-out property <[length]> w;
    in property <[string]> titles;
    in-out property <length> total;
}

// The detail tabs' columns, one set each. Separate from `Cols` because they
// are separate lists with their own saved widths - `column_state` keys by
// list_id for exactly this reason.
export global DCols {
    in-out property <[length]> files;
    in property <[string]> files-titles;
    in-out property <length> files-total;

    in-out property <[length]> peers;
    in property <[string]> peers-titles;
    in-out property <length> peers-total;

    in-out property <[length]> trackers;
    in property <[string]> trackers-titles;
    in-out property <length> trackers-total;
}

/// A cell in a detail tab's list: 12px text in a fixed-width box.
///
/// The tabs used a HorizontalLayout with padding and spacing, which cannot be
/// resized - a column has to be one number the header and the rows both read.
/// `indent` is the Files tree, which was the layout's padding before.
component DCell inherits Rectangle {
    in property <length> w;
    in property <string> text;
    in property <TextHorizontalAlignment> align: left;
    in property <bool> bold;
    in property <length> indent: 0px;
    width: root.w;
    Text {
        text: root.text;
        x: 6px + root.indent;
        width: parent.width - 12px - root.indent;
        height: parent.height;
        font-size: 12px;
        font-weight: root.bold ? 700 : 400;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// The grab handle on a column's right edge.
///
/// Hand-rolled like the two splitters, and for the same reason - Slint has no
/// header widget. Works in ABSOLUTE x: the handle sits inside the column it
/// resizes, so it moves as that column grows, and measuring against its own
/// `mouse-x` would cancel the delta out and the drag would do nothing.
component ColResize inherits Rectangle {
    /// The width it is currently resizing. Passed in rather than read from a
    /// global, so the same handle serves the torrent list and each of the
    /// three detail tabs.
    in property <length> current;
    /// Live, on every move - the caller writes it into whichever model it
    /// owns, and keeps that model's total in step.
    callback resized(length);
    /// Once, when the drag ends. Persisting is a database write, and `moved`
    /// runs per mouse event.
    callback done(length);
    /// Double-clicked: fit this one column to its contents, the way every
    /// other list with draggable columns does.
    callback fit();
    private property <length> start-w;
    private property <length> start-x;
    // Sits ENTIRELY inside its column rather than straddling the boundary:
    // Slint does not deliver pointer events to the part of a child that falls
    // outside its parent, so a straddling handle is only half grabbable - and
    // the dead half is the one on the side people aim at.
    //
    // `x` and `height` are set where it is used: a component's own root has
    // no `parent` to measure against.
    width: 8px;
    Rectangle {
        // Hard against the right edge, so it still reads as the boundary.
        x: 7px;
        width: 1px;
        height: parent.height;
        // Always drawn, not only on hover: an invisible resize edge is one
        // nobody finds. Faint until the pointer is on it.
        background: touch.has-hover ? Palette.accent-background : Palette.border;
    }
    touch := TouchArea {
        mouse-cursor: col-resize;
        // `clicked` fires before this, and the press/release pair below runs
        // twice on the way here - both harmless, because neither changes a
        // width unless the pointer actually moved.
        double-clicked => { root.fit(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.start-w = root.current;
                root.start-x = self.absolute-position.x + self.mouse-x;
            }
            if (e.kind == PointerEventKind.up) {
                root.done(root.current);
            }
        }
        moved => {
            // 40px floor: narrower and the caption has nothing left to elide
            // into, so the column reads as a gap rather than a column.
            root.resized(max(40px,
                root.start-w + ((self.absolute-position.x + self.mouse-x) - root.start-x)));
        }
    }
}

// A Rectangle wrapping a Text, not a Text: `padding-left` is not a Text
// property, so right-aligned values ran straight into the next column.
component Cell inherits Rectangle {
    in property <length> w;
    in property <string> text;
    in property <TextHorizontalAlignment> align: left;
    in property <color> fg: Palette.foreground;
    width: w;
    Text {
        text: root.text;
        color: root.fg;
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        overflow: elide;
        font-size: 13px;
    }
}

// One row of the context menu, drawn by Slint rather than by the platform -
// see the note on ctx-popup for why that is not a style choice.
component MenuRow inherits Rectangle {
    in property <string> label;
    /// Draws a tick to the left of the label, the way a Win32 menu marks a
    /// toggle. Only the View menu's three panel toggles opt in, and they sit
    /// together between separators, so the gutter lines up with itself
    /// without indenting every other row in the menu.
    in property <bool> checkable;
    in property <bool> checked;
    // Greyed and inert, the way a disabled Win32 menu item is - Pause on an
    // already-paused torrent, say.
    in property <bool> enabled: true;
    callback activated;
    // 24px, near the ~22px Windows uses. 30px looked padded out next to a
    // 13px font and made the panel taller than its content needed.
    height: 24px;
    background: root.enabled && touch.has-hover ? Palette.accent-background : transparent;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
    Text {
        // Always laid out, so the label never shifts as the toggle flips -
        // only the glyph appears and disappears.
        text: root.checkable && root.checked ? "\u{2713}" : "";
        x: 12px;
        width: 14px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 13px;
        color: touch.has-hover ? Palette.accent-foreground : Palette.foreground;
    }
    Text {
        text: root.label;
        x: root.checkable ? 30px : 12px;
        width: parent.width - (root.checkable ? 42px : 24px);
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        font-size: 13px;
        color: !root.enabled ? #808080
            : touch.has-hover ? Palette.accent-foreground
            : Palette.foreground;
    }
}

// One title in the hand-drawn menu bar.
component BarTitle inherits Rectangle {
    in property <string> label;
    /// True while this title's own menu is the open one.
    in property <bool> active;
    callback pressed;
    /// Fired on hover. A menu bar switches menus on hover once one is already
    /// open, which is what makes dragging along the bar work.
    callback hovered;
    width: text.preferred-width + 24px;
    background: root.active || touch.has-hover
        ? Palette.alternate-background : transparent;
    touch := TouchArea {
        clicked => { root.pressed(); }
        changed has-hover => {
            if (self.has-hover) { root.hovered(); }
        }
    }
    text := Text {
        text: root.label;
        x: 12px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 13px;
        color: Palette.foreground;
    }
}

component MenuSep inherits Rectangle {
    height: 7px;
    Rectangle { y: 3px; height: 1px; background: Palette.border; }
}


// One value in a details list.
//
// Elided when it does not fit, which is exactly when you cannot read it and
// most want it - so hovering shows the whole thing and clicking puts it on the
// clipboard. The tooltip only appears when the text really is cut off;
// repeating a value that is already fully visible is just noise.
component DataText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 12px;
    in property <bool> bold;
    in property <TextHorizontalAlignment> align: left;
    in property <color> fg: Palette.foreground;

    label := Text {
        text: root.text;
        width: 100%;
        height: 100%;
        font-size: root.font-size;
        font-weight: root.bold ? 700 : 400;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
        color: root.fg;
    }

    TouchArea {
        // A plain left click. Nothing in these lists selects a row, so there
        // is no other meaning for it to compete with.
        clicked => { Clip.copy(root.text); }
    }

    // Custom content rather than `text:`, which is a styled-text and would
    // need @markdown - and markdown eats the underscores and asterisks that
    // turn up in torrent names all the time.
    if label.preferred-width > root.width: Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;
            HorizontalLayout {
                padding: 6px;
                Text {
                    text: root.text;
                    font-size: 12px;
                    color: Palette.foreground;
                }
            }
        }
    }
}

// One "Name: value" pair in the Overview grid.
/// The draggable line between the Overview's two columns.
///
/// Hand-rolled for the same reason as the horizontal splitter above the
/// details panel - Slint has no splitter widget. It reports positions in
/// ABSOLUTE coordinates and lets the window do the arithmetic, because this
/// element moves as the column it resizes changes width: measuring against
/// its own `mouse-x` would cancel the delta out and the drag would appear to
/// do nothing (the same trap the horizontal one documents).
// A toolbar button: an icon, a colour, and nothing else.
//
// Colours are chosen to read on both palettes rather than taken from Palette:
// these are the "traffic light" set (add / remove / start / stop), and their
// meaning IS the colour. They sit on both backgrounds because they are all
// mid-saturation - the same reason qBittorrent's toolbar works in both themes.
component IconButton inherits Rectangle {
    in property <color> tint;
    in property <bool> enabled: true;
    in property <string> tip;
    callback activated();

    width: 34px;
    height: 30px;
    border-radius: 5px;
    // Hover is the only affordance an icon-only button has, so it has to be
    // visible without being loud.
    background: !root.enabled ? transparent
        : touch.has-hover ? Palette.alternate-background : transparent;

    // Greyed rather than hidden: a disabled button still says the action
    // exists and needs a selection. `out` so the glyph placed inside can read
    // it - the caller supplies the shape, this supplies the colour.
    out property <color> ink: root.enabled ? root.tint
        : Palette.foreground.mix(Palette.background, 0.45);
    opacity: root.enabled ? 1.0 : 0.5;

    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if (root.enabled) { root.activated(); } }
    }

    // Centred: a Rectangle is not a layout, so without this the glyph would
    // sit in the top-left corner of the button.
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }

    // An icon-only button says nothing about itself until you hover it. Same
    // hand-rolled tooltip the details lists use, for the same reason: styled
    // text would need @markdown, and markdown eats the punctuation in these.
    Tooltip {
        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;
            HorizontalLayout {
                padding: 6px;
                Text {
                    text: root.tip;
                    font-size: 12px;
                    color: Palette.foreground;
                }
            }
        }
    }
}

// --- the glyphs -----------------------------------------------------------
// Each is 20x20, centred, and takes its colour from `ink`.

// Two interlocking links, for "add magnet".
component LinkIcon inherits Rectangle {
    in property <color> ink;
    width: 20px;
    height: 20px;
    // Stepped diagonally rather than side by side: a horizontal chain is only
    // as tall as one capsule, and at 8px it read as sitting higher than its
    // neighbours even though it was centred. Every glyph here is ~16px tall so
    // they carry the same weight on the shared centre line.
    Rectangle {
        x: 0px; y: 2px; width: 13px; height: 9px;
        border-radius: 4.5px; border-width: 2px; border-color: root.ink;
    }
    Rectangle {
        x: 7px; y: 9px; width: 13px; height: 9px;
        border-radius: 4.5px; border-width: 2px; border-color: root.ink;
    }
    // Joins the two so they read as linked rather than as two separate rings.
    Rectangle {
        x: 8.5px; y: 8px; width: 3px; height: 4px;
        background: root.ink;
    }
}

// A plus inside a ring, for "add torrent".
component PlusIcon inherits Rectangle {
    in property <color> ink;
    width: 20px;
    height: 20px;
    Rectangle {
        x: 2px; y: 2px; width: 16px; height: 16px;
        border-radius: 8px; border-width: 2px; border-color: root.ink;
    }
    Rectangle { x: 6px; y: 9px; width: 8px; height: 2px; background: root.ink; }
    Rectangle { x: 9px; y: 6px; width: 2px; height: 8px; background: root.ink; }
}

// A waste bin, for "remove".
component TrashIcon inherits Rectangle {
    in property <color> ink;
    width: 20px;
    height: 20px;
    // Handle.
    Rectangle { x: 7px; y: 2px; width: 6px; height: 2px; background: root.ink; }
    // Lid.
    Rectangle { x: 2.5px; y: 5px; width: 15px; height: 2px; background: root.ink; }
    // Body.
    Rectangle {
        x: 4px; y: 8px; width: 12px; height: 10px;
        border-radius: 2px; border-width: 2px; border-color: root.ink;
    }
    Rectangle { x: 8px; y: 10.5px; width: 1.5px; height: 5px; background: root.ink; }
    Rectangle { x: 10.5px; y: 10.5px; width: 1.5px; height: 5px; background: root.ink; }
}

// A play triangle, for "start / resume".
component PlayIcon inherits Rectangle {
    in property <color> ink;
    width: 20px;
    height: 20px;
    Path {
        width: 20px;
        height: 20px;
        viewbox-width: 20;
        viewbox-height: 20;
        fill: root.ink;
        commands: "M 4 2 L 17 10 L 4 18 Z";
    }
}

// A filled square, for "stop / pause".
component StopIcon inherits Rectangle {
    in property <color> ink;
    width: 20px;
    height: 20px;
    Rectangle {
        x: 2px; y: 2px; width: 16px; height: 16px;
        border-radius: 2px;
        background: root.ink;
    }
}

// A cog, for "preferences". A straight-line polygon: see the note on
// IconButton about not depending on SVG arc support.
component GearIcon inherits Rectangle {
    in property <color> ink;
    width: 20px;
    height: 20px;
    // A solid cog, hub and all. The hub used to be punched out in the colour
    // behind it, which only works while that colour is known - the button is
    // transparent until hovered, so the punch did nothing and the deep teeth
    // left it reading as an asterisk. Shallower teeth and no hole is the shape
    // that survives being 16px tall.
    Path {
        x: 1px;
        y: 1px;
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M 22.67 9.34 L 22.67 14.66 L 20.18 14.66 L 19.66 15.90 L 21.43 17.67 L 17.67 21.43 L 15.90 19.66 L 14.66 20.18 L 14.66 22.67 L 9.34 22.67 L 9.34 20.18 L 8.10 19.66 L 6.33 21.43 L 2.57 17.67 L 4.34 15.90 L 3.82 14.66 L 1.33 14.66 L 1.33 9.34 L 3.82 9.34 L 4.34 8.10 L 2.57 6.33 L 6.33 2.57 L 8.10 4.34 L 9.34 3.82 L 9.34 1.33 L 14.66 1.33 L 14.66 3.82 L 15.90 4.34 L 17.67 2.57 L 21.43 6.33 L 19.66 8.10 L 20.18 9.34 Z";
    }
}

// --- details tab bar ------------------------------------------------------
// The built-in TabWidget stretches its tabs across the full width and takes a
// title string only. These are sized to their own content and carry an icon,
// which is what every other client's detail pane looks like.

// Bar chart, for Overview.
component OverviewIcon inherits Rectangle {
    in property <color> ink;
    width: 16px;
    height: 16px;
    Rectangle { x: 1px;  y: 8px;  width: 3px; height: 7px; background: root.ink; }
    Rectangle { x: 6px;  y: 4px;  width: 3px; height: 11px; background: root.ink; }
    Rectangle { x: 11px; y: 1px;  width: 3px; height: 14px; background: root.ink; }
}

// A sheet of paper, for Files.
component FilesIcon inherits Rectangle {
    in property <color> ink;
    width: 16px;
    height: 16px;
    Rectangle {
        x: 2px; y: 1px; width: 12px; height: 14px;
        border-radius: 2px; border-width: 1.5px; border-color: root.ink;
    }
    Rectangle { x: 5px; y: 5px;  width: 6px; height: 1.5px; background: root.ink; }
    Rectangle { x: 5px; y: 8px;  width: 6px; height: 1.5px; background: root.ink; }
    Rectangle { x: 5px; y: 11px; width: 4px; height: 1.5px; background: root.ink; }
}

// Two figures, for Peers.
component PeersIcon inherits Rectangle {
    in property <color> ink;
    width: 16px;
    height: 16px;
    Rectangle { x: 2px; y: 2px; width: 5px; height: 5px; border-radius: 2.5px; background: root.ink; }
    Rectangle { x: 0.5px; y: 8px; width: 8px; height: 6px; border-radius: 3px; background: root.ink; }
    Rectangle { x: 9px; y: 3.5px; width: 4px; height: 4px; border-radius: 2px; background: root.ink; }
    Rectangle { x: 8px; y: 9px; width: 7.5px; height: 5px; border-radius: 2.5px; background: root.ink; }
}

// Concentric rings, for Trackers - the announce going out.
component TrackersIcon inherits Rectangle {
    in property <color> ink;
    width: 16px;
    height: 16px;
    Rectangle {
        x: 1px; y: 1px; width: 14px; height: 14px;
        border-radius: 7px; border-width: 1.5px; border-color: root.ink;
    }
    Rectangle {
        x: 4.5px; y: 4.5px; width: 7px; height: 7px;
        border-radius: 3.5px; border-width: 1.5px; border-color: root.ink;
    }
    Rectangle { x: 6.75px; y: 6.75px; width: 2.5px; height: 2.5px; border-radius: 1.25px; background: root.ink; }
}

component DetailTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    // Sized to its content, not to a share of the width.
    horizontal-stretch: 0;
    height: 28px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    background: root.selected ? Palette.background
        : tab-touch.has-hover ? Palette.alternate-background : transparent;

    // Mixed toward the background rather than a fixed grey: an unselected tab
    // has to read as available-but-not-current on BOTH palettes, and #8a8a8a
    // against the light background looked disabled.
    //
    // Weighted heavily toward the foreground (0.85, not 0.65) because at the
    // lower value it still read as disabled: ~#6a6a6a on white and ~#8a8a8a on
    // near-black. What separates the current tab is the accent icon, the bold
    // label and the underline - it does not also need the others to be faint.
    out property <color> muted: Palette.foreground.mix(Palette.background, 0.85);
    out property <color> ink: root.selected ? Palette.accent-background : root.muted;

    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        VerticalLayout { alignment: center; @children }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.selected ? 700 : 400;
            vertical-alignment: center;
            color: root.selected ? Palette.foreground : root.muted;
        }
    }

    // The selected tab joins the panel below it.
    if root.selected: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Palette.accent-background;
    }
}

component VDivider inherits Rectangle {
    /// Absolute x of the press, and of each subsequent move.
    callback grabbed(length);
    callback dragged(length);
    /// Fired once when the drag ends, so the result can be persisted.
    callback released();
    // Wider than the line it draws: 1px is a pixel-hunt to grab.
    width: 11px;
    Rectangle {
        x: 5px;
        width: 1px;
        height: parent.height;
        background: touch.has-hover ? Palette.accent-background : Palette.border;
    }
    touch := TouchArea {
        mouse-cursor: col-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.grabbed(self.absolute-position.x + self.mouse-x);
            }
            if (e.kind == PointerEventKind.up) {
                root.released();
            }
        }
        moved => { root.dragged(self.absolute-position.x + self.mouse-x); }
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    // The row rhythm lives here rather than in the grid's spacing: the
    // divider between the two columns has to be one unbroken line, and a
    // 6px gap between rows would have chopped it into dashes.
    min-height: 26px;
    Text {
        text: root.label;
        font-weight: 700;
        font-size: 13px;
        width: 110px;
        vertical-alignment: center;
    }
    DataText {
        text: root.value;
        font-size: 13px;
        horizontal-stretch: 1;
    }
}

export component MainWindow inherits Window {
    // Fires while the window is being dragged, not only when it settles -
    // columns that lag behind the frame look broken, and the handler is a few
    // multiplications.
    changed width => { root.window-width-changed(self.width); }
    // Title bar and taskbar icon. The exe gets its icon from a Win32 resource
    // in build.rs; the window needs telling separately.
    icon: @image-url("../../res/app.png");
    in property <string> window-title;
    title: root.window-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    // A floor, not a default. Below roughly this the list shows only the first
    // couple of columns and the splitter runs out of room - the details panel
    // will not go under 120px and the list keeps 220px, so anything much
    // shorter leaves one of them unusable.
    min-width: 800px;
    min-height: 520px;
    background: Palette.background;

    in property <[Row]> rows;
    // Which column the list is sorted by, and which way, so the header can say
    // so. -1 means the session's own order.
    in property <int> sort-column: -1;
    in property <bool> sort-ascending: true;
    in property <string> status;
    in property <int> selected-count;
    in property <string> dht-nodes: "105";
    in property <string> session-rates: "DL: 0 bytes/s, UL: 0 bytes/s";

    // Details of the selected torrent.
    in property <string> d-name: "-";
    in property <string> d-hash: "-";
    /// Set from Rust because which hashes exist is a property of the torrent,
    /// not of the layout: a v1 torrent keeps the plain "Info hash", a v2 one
    /// says so, and only a hybrid shows two rows.
    in property <string> d-hash-label;
    in property <string> d-hash2;
    in property <string> d-hash2-label;
    in property <string> d-save-path: "-";
    in property <string> d-status: "-";
    in property <string> d-downloaded: "-";
    in property <string> d-uploaded: "-";
    in property <string> d-ratio: "-";
    in property <string> d-peers: "-";
    in property <string> d-added: "-";
    in property <string> d-completed: "-";
    in property <float> d-progress: 0;

    // Detail tabs. Only the visible one is refreshed - see current-tab.
    in property <[FileEntryRow]> detail-files;
    in property <[PeerEntryRow]> detail-peers;
    in property <[TrackerEntryRow]> detail-trackers;
    // in-out and bound from inside the TabWidget, not `tabs.current-index`:
    // the widget lives inside an `if`, and ids declared in a conditional are
    // not in scope out here.
    in-out property <int> current-tab;

    // Splitter position - the Win32 frame keeps the same thing in
    // MainWindow::details_height.
    in-out property <length> details-height: 260px;
    // Captured when the splitter is grabbed - see the note on its TouchArea.
    private property <length> drag-start-height;
    private property <length> drag-start-y;
    /// Width of the Overview's left column. Not persisted, matching
    /// `details-height` above - both reset to a sane default each launch.
    in-out property <length> details-split: 420px;
    private property <length> drag-start-split;
    private property <length> drag-start-x;
    in-out property <bool> show-details: true;
    in-out property <bool> show-status: true;

    // Where the pending context menu should open, stashed by the press.
    private property <length> menu-x;
    private property <length> menu-y;

    // The context menu is drawn by Slint, not by the platform, and that is not
    // a style choice.
    //
    // Slint's Menu / ContextMenuArea use native menus on Windows (muda ->
    // TrackPopupMenu), which run a NESTED MODAL MESSAGE LOOP. Two things follow,
    // both observed rather than theorised:
    //
    //  1. No frame is painted between updating the selection and the menu
    //     appearing, so the row highlighted was whichever was selected before.
    //  2. A right-click while a menu is open is consumed dismissing it and then
    //     re-delivered to the row that OPENED it - so right-clicking a second
    //     torrent reported the first row's index and reopened the menu in the
    //     first row's position.
    //
    // Deferring the show with a timer papered over (1) and could not touch (2);
    // the callback never saw the second row at all. A Slint-drawn PopupWindow
    // has no modal loop, so the selection paints normally and every click lands
    // where it was aimed. It also follows the Palette, which the native menu
    // did not - that rendered light on a dark window.
    // Right-clicking a column header. Separate from the row menu below: that
    // one acts on the selected torrents, this one on the list's geometry, and
    // sharing it would put six torrent actions on the Files tab.
    col-popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 260px;
        height: col-menu.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;
            col-menu := VerticalLayout {
                padding: 4px;
                MenuRow {
                    label: L.s(L.revision, "reset_column_widths");
                    activated => {
                        root.columns-reset(root.header-menu-list);
                        col-popup.close();
                    }
                }
            }
        }
    }

    ctx-popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        // Sized to fit the longest label ("Remove torrent and files") rather
        // than to a round number.
        width: 210px;
        // Bound to the layout instead of hardcoded, so adding or removing an
        // item cannot leave dead space at the bottom or clip the last row.
        height: menu-layout.preferred-height;
        // A Slint PopupWindow captures the pointer while it is open, whatever
        // the close policy, so a click on another row never reaches that row.
        // no-auto-close was tried and only added the risk of a menu that will
        // not go away; close-on-click-outside at least always dismisses.
        //
        // Consequence, and it is a real one: right-clicking a second torrent
        // while the menu is open dismisses it rather than moving the menu
        // there, so it takes a second right-click. Windows moves it in one.
        // Matching that needs a window-sized popup with a transparent scrim
        // that catches the click and maps its y back to a row - see the note
        // in the module docs.
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuRow {
                    label: L.s(L.revision, "pause");
                    enabled: root.ctx-can-pause;
                    activated => { root.action("pause"); ctx-popup.close(); }
                }
                MenuRow {
                    label: L.s(L.revision, "resume");
                    enabled: root.ctx-can-resume;
                    activated => { root.action("resume"); ctx-popup.close(); }
                }
                MenuRow { label: L.s(L.revision, "force_recheck"); activated => { root.action("recheck"); ctx-popup.close(); } }
                MenuSep { }
                MenuRow { label: L.s(L.revision, "move"); activated => { root.action("move"); ctx-popup.close(); } }
                MenuRow { label: L.s(L.revision, "set_location"); activated => { root.action("set-location"); ctx-popup.close(); } }
                // Assigning a label, as opposed to View > Labels which filters
                // by one. Drawn inline rather than as a nested PopupWindow:
                // the outer popup closes on any click outside itself, so a
                // child popup never gets its click.
                MenuRow {
                    label: L.s(L.revision, "label") + "  " + (root.ctx-labels-open ? "-" : "+");
                    activated => { root.ctx-labels-open = !root.ctx-labels-open; }
                }
                if root.ctx-labels-open: VerticalLayout {
                    for name[i] in root.ctx-label-names: MenuRow {
                        label: "    " + name;
                        activated => { root.assign-label(i); ctx-popup.close(); }
                    }
                }
                MenuSep { }
                MenuRow {
                    label: L.s(L.revision, "queue_position_menu") + "  " + (root.ctx-queue-open ? "-" : "+");
                    activated => { root.ctx-queue-open = !root.ctx-queue-open; }
                }
                if root.ctx-queue-open: VerticalLayout {
                    MenuRow { label: "    " + L.s(L.revision, "up"); activated => { root.action("queue-up"); ctx-popup.close(); } }
                    MenuRow { label: "    " + L.s(L.revision, "down"); activated => { root.action("queue-down"); ctx-popup.close(); } }
                }
                MenuSep { }
                MenuRow { label: L.s(L.revision, "remove_torrent"); activated => { root.action("remove"); ctx-popup.close(); } }
                MenuRow { label: L.s(L.revision, "remove_torrent_and_files"); activated => { root.action("remove-files"); ctx-popup.close(); } }
                MenuSep { }
                MenuRow { label: L.s(L.revision, "copy_info_hash"); activated => { root.action("copy-hash"); ctx-popup.close(); } }
                MenuRow { label: L.s(L.revision, "magnet_link_s"); activated => { root.action("copy-magnet"); ctx-popup.close(); } }
                MenuRow { label: L.s(L.revision, "open_in_explorer"); activated => { root.action("open-folder"); ctx-popup.close(); } }
            }
        }
    }

    callback sort(int);
    /// A column's new width, once the drag has finished. Rust remembers it.
    callback column-resized(int, length);
    /// The details panel's height and its internal divider, once a drag has
    /// finished. Same reason as above: persisting is a database write, and the
    /// drag handlers run per mouse event.
    callback panel-resized(length, length);
    /// Which tab (0 files, 1 peers, 2 trackers), which column, new width.
    callback detail-column-resized(int, int, length);

    // --- column sizing menu ------------------------------------------------
    /// Which list the header menu was opened on: 0 torrents, 1 files,
    /// 2 peers, 3 trackers. Matches RESIZABLE_LISTS in Rust.
    private property <int> header-menu-list;
    /// Fit every column in this list to its content, once.
    callback columns-reset(int);
    /// Fit ONE column to its content: which list, which column. The list index
    /// is the RESIZABLE_LISTS one, so the detail tabs are 1..3 here even
    /// though `detail-column-resized` numbers the tabs 0..2.
    callback column-fit(int, int);
    /// The window got wider or narrower. Only the Overview reacts: its right
    /// half holds the info hashes, which have a width worth keeping whole,
    /// so the left half takes the change.
    callback window-width-changed(length);
    callback row-pressed(int, bool, bool);
    /// Delete on the torrent list. Named for what it opens rather than what it
    /// does, because it does nothing until the dialog comes back.
    callback remove-prompt();
    /// Ctrl+A on the torrent list.
    callback select-all();
    /// Clicking the empty space below the rows clears the selection.
    callback clear-selection();
    /// True while a dialog is open - see ui_slint/modal.rs.
    in property <bool> blocked;
    // Set from the same callback that opens the context menu, judged by the
    // first selected torrent, so Pause/Resume grey out correctly.
    in property <bool> ctx-can-pause: true;
    in property <bool> ctx-can-resume: true;
    /// Label names for the assign submenu, "None" first to clear one.
    in property <[string]> ctx-label-names;
    in-out property <bool> filters-open;
    in-out property <bool> labels-open;
    in-out property <bool> theme-open;
    /// Which menu-bar dropdown is open: 0 none, 1 File, 2 View, 3 Help.
    in-out property <int> open-menu;
    changed open-menu => {
        // A submenu left expanded would still be expanded next time the menu
        // opens, which reads as it never having closed.
        root.filters-open = false;
        root.labels-open = false;
        root.theme-open = false;
    }
    in-out property <bool> ctx-labels-open;
    in-out property <bool> ctx-queue-open;
    callback assign-label(int);
    // Fired before the context menu opens so the Rust side can make the
    // right-clicked row the selection, exactly as the Win32 list does.
    callback context-menu(int);
    // One string rather than a callback per item: the menu is data, and the
    // dispatch table in mod.rs is easier to keep in step with lang/*.json than
    // twenty separate signals would be.
    callback action(string);
    // Named PQL filters and labels from the database, plus a leading "None".
    in property <[string]> filter-names;
    in property <[string]> label-names;
    callback pick-filter(int);
    callback pick-label(int);

    /// Plugins that have declared a menu of their own. Each becomes a
    /// dropdown in the bar, titled by the plugin.
    ///
    /// Only the OPEN menu's items are held, rather than every plugin's at
    /// once: Slint structs do not nest arrays, and one plugin's dropdown is
    /// open at a time anyway. Pressing a title asks Rust to fill them.
    in property <[string]> plugin-menu-titles;
    in property <[PluginButton]> plugin-menu-items;
    /// Which plugin title is open, as an index into `plugin-menu-titles`, and
    /// where it sits in the bar. The bar titles are a for-loop, so their x is
    /// not reachable from the dropdown declared outside it - the title records
    /// its own position on the way past.
    in-out property <int> open-plugin: -1;
    in-out property <length> plugin-menu-x;
    callback open-plugin-menu(int);
    callback activate-plugin-menu(string);

    // The PQL console. `console-valid` drives the border colour, so a
    // half-typed expression looks unfinished rather than broken.
    in-out property <bool> show-console;
    in-out property <string> console-text;
    in property <bool> console-valid: true;
    callback console-changed(string);
    /// Persist a View toggle. Key is the configuration key, so one callback
    /// serves all three rather than one apiece.
    callback view-toggled(string, bool);

    /// "system", "light" or "dark" - the same theme_id the Win32 menu writes.
    /// Setting Palette.color-scheme is what makes the menu popups follow the
    /// app: they are separate windows and do not inherit it otherwise.
    in-out property <string> theme-id: "system";
    callback pick-theme(string);

    changed theme-id => {
        Palette.color-scheme = root.theme-id == "dark" ? ColorScheme.dark
            : root.theme-id == "light" ? ColorScheme.light
            : ColorScheme.unknown;
    }

    // Native on macOS (top of the screen), Slint-drawn elsewhere. Port of the
    // menu bar built in mainwindow.rs.
    // A hand-drawn menu bar, not Slint's `MenuBar`.
    //
    // On Windows and macOS the winit backend routes MenuBar through muda, whose
    // popups take their colours from the OS scheme and ignore `Palette`
    // entirely - so with theme_id forced to Light on a dark desktop (or the
    // reverse) the menus came up in the wrong theme. `supports_native_menu_bar`
    // is hardcoded to true there with no runtime opt-out, so the only way to
    // theme them is to draw them, which is what `ctx-popup` already does for
    // the torrent context menu.
    //
    // Cost of this: no Alt-key access and no OS keyboard navigation, which the
    // native bar gave for free.
    // The dropdowns. Each is a PopupWindow so it can paint outside the bar,
    // and each closes on a click elsewhere.
    VerticalLayout {
        menu-bar := Rectangle {
            height: 30px;
            background: Palette.background;

            HorizontalLayout {
                alignment: start;
                file-title := BarTitle {
                    label: L.s(L.revision, "amp_file");
                    active: root.open-menu == 1;
                    pressed => { root.open-menu = root.open-menu == 1 ? 0 : 1; }
                    // Only switches when a menu is already open, so merely
                    // moving the pointer across the bar does nothing.
                    hovered => { if (root.open-menu != 0) { root.open-menu = 1; } }
                }
                view-title := BarTitle {
                    label: L.s(L.revision, "amp_view");
                    active: root.open-menu == 2;
                    pressed => { root.open-menu = root.open-menu == 2 ? 0 : 2; }
                    hovered => { if (root.open-menu != 0) { root.open-menu = 2; } }
                }
                help-title := BarTitle {
                    label: L.s(L.revision, "amp_help");
                    active: root.open-menu == 3;
                    pressed => { root.open-menu = root.open-menu == 3 ? 0 : 3; }
                    hovered => { if (root.open-menu != 0) { root.open-menu = 3; } }
                }
                // One per plugin that asked for a menu, after the built-in
                // three so the bar people know does not move when a plugin is
                // switched on. `self.x` is the window x here: this layout
                // starts at the left edge of the bar, which starts at the left
                // edge of the window - the same assumption the dropdowns above
                // already make with `file-title.x`.
                for title[i] in root.plugin-menu-titles: BarTitle {
                    label: title;
                    active: root.open-menu == 4 && root.open-plugin == i;
                    pressed => {
                        if (root.open-menu == 4 && root.open-plugin == i) {
                            root.open-menu = 0;
                        } else {
                            root.open-plugin = i;
                            root.plugin-menu-x = self.x;
                            root.open-plugin-menu(i);
                            root.open-menu = 4;
                        }
                    }
                    hovered => {
                        if (root.open-menu != 0) {
                            root.open-plugin = i;
                            root.plugin-menu-x = self.x;
                            root.open-plugin-menu(i);
                            root.open-menu = 4;
                        }
                    }
                }
            }
        }

        padding: 0px;
        spacing: 0px;

        // --- PQL console ----------------------------------------------------
        if root.show-console: Rectangle {
            height: 34px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 4px;
                spacing: 6px;
                Text {
                    text: ">";
                    font-family: "Consolas";
                    font-size: 14px;
                    font-weight: 700;
                    width: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: root.console-valid ? Palette.foreground : #f2705f;
                }
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "name contains \"linux\" and size > 100mb";
                    text <=> root.console-text;
                    edited => { root.console-changed(self.text); }
                }
            }
        }

        // --- toolbar ---------------------------------------------------------
        // Icon-only, like every other torrent client's: the actions are the
        // ones reached constantly, and the menus keep the rest. The three that
        // act on a selection disable themselves without one rather than
        // failing silently when pressed.
        Rectangle {
            height: 38px;
            background: Palette.background;

            HorizontalLayout {
                // A Rectangle is not a layout, so a child without explicit
                // geometry is placed at its own preferred size in the top-left
                // corner - which left the 30px button row hard against the top
                // of a 38px bar with 8px of dead space under it. Filling the
                // parent and padding evenly is what centres the row.
                width: 100%;
                height: 100%;
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: start;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;

                IconButton {
                    tint: #2f80ed;
                    tip: L.s(L.revision, "add_magnet_link_s");
                    activated => { root.action("add-magnet"); }
                    LinkIcon { ink: parent.ink; }
                }
                IconButton {
                    tint: #2f80ed;
                    tip: L.s(L.revision, "add_torrent_s");
                    activated => { root.action("add-torrent"); }
                    PlusIcon { ink: parent.ink; }
                }

                // Separator, as in the reference clients: adding is one group,
                // acting on a selection is another.
                Rectangle {
                    width: 9px;
                    Rectangle {
                        x: 4px; y: 7px; width: 1px; height: 16px;
                        background: Palette.border;
                    }
                }

                IconButton {
                    tint: #e5484d;
                    enabled: root.selected-count > 0;
                    tip: L.s(L.revision, "remove");
                    activated => { root.action("remove"); }
                    TrashIcon { ink: parent.ink; }
                }
                IconButton {
                    tint: #2ea043;
                    enabled: root.selected-count > 0;
                    tip: L.s(L.revision, "resume");
                    activated => { root.action("resume"); }
                    PlayIcon { ink: parent.ink; }
                }
                IconButton {
                    tint: #e8912d;
                    enabled: root.selected-count > 0;
                    tip: L.s(L.revision, "pause");
                    activated => { root.action("pause"); }
                    StopIcon { ink: parent.ink; }
                }

                Rectangle {
                    width: 9px;
                    Rectangle {
                        x: 4px; y: 7px; width: 1px; height: 16px;
                        background: Palette.border;
                    }
                }

                IconButton {
                    tint: #8b5cf6;
                    tip: L.s(L.revision, "preferences");
                    activated => { root.action("preferences"); }
                    GearIcon { ink: parent.ink; }
                }
            }
        }

        // --- torrent list ---------------------------------------------------
        scroll := ScrollView {
            vertical-stretch: 1;
            viewport-width: Cols.total;
            // The ListView inside owns vertical scrolling; two of them fight.
            vertical-scrollbar-policy: always-off;

            VerticalLayout {
                header := Rectangle {
                    height: 28px;
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        // A Rectangle with an explicit width, with the
                        // TouchArea inside it - exactly what `Cell` does for
                        // the rows below, and for the same reason. A TouchArea
                        // sizes to its content, so `width: parent.width - 12px`
                        // on the Text was circular and the caption never got a
                        // real width to elide against: "Size (remaining)" then
                        // ran straight into "Status" on Linux, whose default
                        // font is wider than the Windows one.
                        for title[i] in Cols.titles: Rectangle {
                            width: Cols.w[i];
                            TouchArea {
                                clicked => { root.sort(i); }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right
                                        && e.kind == PointerEventKind.down) {
                                        root.menu-x = self.absolute-position.x + self.mouse-x;
                                        root.menu-y = self.absolute-position.y + self.mouse-y;
                                        root.header-menu-list = 0;
                                        col-popup.show();
                                    }
                                }
                            }
                            Text {
                                // The arrow goes in the caption rather than a
                                // separate element so it cannot drift out of
                                // the column when widths change.
                                text: i == root.sort-column
                                    ? title + (root.sort-ascending ? "  ^" : "  v")
                                    : title;
                                font-size: 13px;
                                font-weight: 600;
                                x: 6px;
                                width: parent.width - 12px;
                                height: parent.height;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            // Declared after the sort TouchArea above, so a
                            // drag on the edge resizes rather than re-sorting:
                            // later siblings win the hit test.
                            ColResize {
                                current: Cols.w[i];
                                x: parent.width - 8px;
                                height: parent.height;
                                resized(width) => {
                                    Cols.total += width - Cols.w[i];
                                    Cols.w[i] = width;
                                }
                                done(width) => { root.column-resized(i, width); }
                                fit() => { root.column-fit(0, i); }
                            }
                        }
                    }
                }

                // Wrapped so a click on the empty space below the last row
                // lands somewhere.
                Rectangle {
                    vertical-stretch: 1;
                  // Delete removes what is selected. A FocusScope around the
                  // whole list rather than per row: rows come and go on every
                  // refresh tick, and focus that lives on one would be lost
                  // the moment the model updated.
                  list-keys := FocusScope {
                    // Focused up front, not just on click: otherwise Ctrl+A or
                    // Delete on a freshly opened window go nowhere, and there
                    // is nothing on screen to explain why.
                    init => { self.focus(); }
                    key-pressed(event) => {
                        if (event.text == Key.Delete) {
                            root.remove-prompt();
                            return accept;
                        }
                        // Ctrl+A. event.text is the character the key would
                        // type, so it is compared lower-case - with Shift also
                        // held it would arrive as "A".
                        if (event.modifiers.control && event.text.to-lowercase() == "a") {
                            root.select-all();
                            return accept;
                        }
                        return reject;
                    }
                  list := ListView {
                    // ListView culls to the viewport, so 5,000 rows cost the
                    // same as 50. That is what the Win32 list does NOT do.
                    for row[i] in root.rows: Rectangle {
                        height: 26px;
                        background: row.selected
                            ? Palette.selection-background
                            : (mod(i, 2) == 0 ? transparent : Palette.alternate-background);

                        ta := TouchArea {
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    // Focus the list so Delete reaches the
                                    // scope below - a TouchArea does not take
                                    // focus on its own.
                                    list-keys.focus();
                                    if (e.button == PointerEventButton.right) {
                                        // Select and show in the same event -
                                        // there is no modal loop to work around
                                        // now. The popup positions relative to
                                        // the window, hence absolute coords.
                                        root.context-menu(i);
                                        root.menu-x = ta.absolute-position.x + ta.mouse-x;
                                        root.menu-y = ta.absolute-position.y + ta.mouse-y;
                                        ctx-popup.show();
                                    } else {
                                        root.row-pressed(i, e.modifiers.control, e.modifiers.shift);
                                    }
                                }
                            }
                            // No `clicked` handler: pointer-event already fires on
                            // press AND carries the modifiers, so a second handler
                            // overwrote every ctrl-click with a plain one.
                        }

                        HorizontalLayout {
                            Cell { w: Cols.w[0]; text: row.name; fg: row.selected ? Palette.selection-foreground : Palette.foreground; }
                            Cell { w: Cols.w[1]; text: row.queue; align: right; }
                            Cell { w: Cols.w[2]; text: row.size; align: right; }
                            Cell { w: Cols.w[3]; text: row.remaining; align: right; }
                            Cell { w: Cols.w[4]; text: row.status; }

                            // The cell StandardTableView could never draw.
                            Rectangle {
                                width: Cols.w[5];
                                Rectangle {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    background: #00000022;
                                    border-radius: 3px;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * row.progress;
                                        height: parent.height;
                                        background: #2f6fb5;
                                        border-radius: 3px;
                                    }
                                    Text {
                                        // floor, not round: round() turns a torrent that is
                                        // 99.98% done into "100 %" while the Status column
                                        // still - correctly - says Downloading. The files are
                                        // preallocated at full size, so on disk it looks
                                        // finished too, and the only honest reading was the
                                        // remaining-size column. Never claim 100 until it is.
                                        text: row.progress >= 1.0
                                            ? "100 %"
                                            : floor(row.progress * 1000) / 10 + " %";
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }

                            Cell { w: Cols.w[6]; text: row.eta; align: right; }
                            Cell { w: Cols.w[7]; text: row.dl; align: right; }
                            Cell { w: Cols.w[8]; text: row.ul; align: right; }
                            Cell { w: Cols.w[9]; text: row.availability; align: right; }
                            Cell { w: Cols.w[10]; text: row.ratio; align: right; }
                            Cell { w: Cols.w[11]; text: row.seeds; align: right; }
                            Cell { w: Cols.w[12]; text: row.peers; align: right; }
                            Cell { w: Cols.w[13]; text: row.added; }
                            Cell { w: Cols.w[14]; text: row.completed; }
                            Cell { w: Cols.w[15]; text: row.label; }
                        }
                    }
                  }
                  }

                    // A Flickable grabs the mouse on press, so a TouchArea
                    // BEHIND the list would never see a click. This one sits on
                    // top and covers only the gap below the last row, so it
                    // cannot steal a row's click - and is zero-height once the
                    // rows fill the view.
                    TouchArea {
                        y: min(root.rows.length * 26px, parent.height);
                        width: parent.width;
                        height: parent.height - self.y;
                        clicked => { root.clear-selection(); }
                    }
                }

            }
        }

        // --- splitter --------------------------------------------------------
        // Slint has no splitter widget, so this is hand-rolled - which is also
        // what the Win32 frame does (MainWindow::splitter_dragging).
        if root.show-details: Rectangle {
            height: 6px;
            background: Palette.border;
            TouchArea {
                mouse-cursor: row-resize;
                // Anchored to the position at press, in ABSOLUTE coordinates.
                // The obvious `details-height - (mouse-y - pressed-y)` does not
                // work: this TouchArea sits on top of the panel it resizes, so
                // it moves as the height changes and mouse-y moves with it,
                // cancelling the delta out. The drag appears to do nothing.
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.drag-start-height = root.details-height;
                        root.drag-start-y = self.absolute-position.y + self.mouse-y;
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.panel-resized(root.details-height, root.details-split);
                    }
                }
                moved => {
                    root.details-height = min(
                        max(root.drag-start-height
                            - ((self.absolute-position.y + self.mouse-y) - root.drag-start-y),
                            120px),
                        root.height - 220px);
                }
            }
        }

        // --- details panel ---------------------------------------------------
        if root.show-details: VerticalLayout {
            // Was a TabWidget. Replaced because that widget stretches its tabs
            // over the full width and has no room for an icon; `current-tab`
            // was already an in-out property, so only the chrome changed.
            // NOT `height:`. A VerticalLayout assigns its children's geometry,
            // so an explicit height competes with the layout rather than
            // constraining it - which is why dragging the splitter changed
            // details-height and nothing moved. Pinning min == max is how a
            // layout child is given a fixed size.
            min-height: root.details-height;
            max-height: root.details-height;

            Rectangle {
                height: 29px;
                background: Palette.alternate-background;
                // The line the selected tab breaks out of.
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Palette.border;
                }
                HorizontalLayout {
                    alignment: start;
                    padding-left: 6px;
                    padding-top: 1px;
                    spacing: 2px;
                    DetailTab {
                        label: L.s(L.revision, "overview");
                        selected: root.current-tab == 0;
                        picked => { root.current-tab = 0; }
                        OverviewIcon { ink: parent.ink; }
                    }
                    DetailTab {
                        label: L.s(L.revision, "files");
                        selected: root.current-tab == 1;
                        picked => { root.current-tab = 1; }
                        FilesIcon { ink: parent.ink; }
                    }
                    DetailTab {
                        label: L.s(L.revision, "peers");
                        selected: root.current-tab == 2;
                        picked => { root.current-tab = 2; }
                        PeersIcon { ink: parent.ink; }
                    }
                    DetailTab {
                        label: L.s(L.revision, "trackers");
                        selected: root.current-tab == 3;
                        picked => { root.current-tab = 3; }
                        TrackersIcon { ink: parent.ink; }
                    }
                }
            }

            if root.current-tab == 0: VerticalLayout {
                vertical-stretch: 1;
                // Scrolls: drag the splitter far enough up and the fields no
                // longer fit, and without this they were simply unreachable.
                ScrollView {
                    VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    Text { text: L.s(L.revision, "pieces"); font-weight: 700; font-size: 13px; }
                    Rectangle {
                        height: 18px;
                        background: #00000022;
                        border-radius: 3px;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.d-progress;
                            height: parent.height;
                            background: #2f6fb5;
                            border-radius: 3px;
                        }
                    }

                    // Cells are placed by explicit row/col rather than with
                    // `Row`, so the divider can rowspan the whole grid: one
                    // continuous line and one drag target instead of five
                    // stacked ones. Keeping the GridLayout (rather than two
                    // side-by-side columns) is what keeps the left and right
                    // labels on the same baseline - including when a hybrid
                    // torrent makes the first row two lines tall.
                    GridLayout {
                        spacing: 0px;

                        VDivider {
                            row: 0;
                            col: 1;
                            rowspan: 5;
                            grabbed(x) => {
                                root.drag-start-split = root.details-split;
                                root.drag-start-x = x;
                            }
                            released => {
                                root.panel-resized(root.details-height, root.details-split);
                            }
                            dragged(x) => {
                                // Floor before ceiling: on a narrow window the
                                // upper bound can fall below the lower one, and
                                // min() of a smaller max would pin the column
                                // shut.
                                root.details-split = min(
                                    max(root.drag-start-split + (x - root.drag-start-x), 200px),
                                    max(220px, root.width - 320px));
                            }
                        }

                        Field {
                            row: 0; col: 0; width: root.details-split;
                            label: L.s(L.revision, "name"); value: root.d-name;
                        }
                        // Stacked inside the one cell rather than added as
                        // another grid row: the second hash belongs beside
                        // the first, and this leaves every other row's
                        // alignment alone.
                        VerticalLayout {
                            row: 0; col: 2;
                            Field { label: root.d-hash-label; value: root.d-hash; }
                            if root.d-hash2 != "": Field {
                                label: root.d-hash2-label;
                                value: root.d-hash2;
                            }
                        }

                        Field {
                            row: 1; col: 0; width: root.details-split;
                            label: L.s(L.revision, "save_path"); value: root.d-save-path;
                        }
                        Field { row: 1; col: 2; label: L.s(L.revision, "status"); value: root.d-status; }

                        Field {
                            row: 2; col: 0; width: root.details-split;
                            label: L.s(L.revision, "downloaded"); value: root.d-downloaded;
                        }
                        Field { row: 2; col: 2; label: L.s(L.revision, "uploaded"); value: root.d-uploaded; }

                        Field {
                            row: 3; col: 0; width: root.details-split;
                            label: L.s(L.revision, "ratio"); value: root.d-ratio;
                        }
                        Field { row: 3; col: 2; label: L.s(L.revision, "peers"); value: root.d-peers; }

                        Field {
                            row: 4; col: 0; width: root.details-split;
                            label: L.s(L.revision, "added_on"); value: root.d-added;
                        }
                        Field { row: 4; col: 2; label: L.s(L.revision, "completed_on"); value: root.d-completed; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            if root.current-tab == 1: VerticalLayout {
                vertical-stretch: 1;
                // Scrolls horizontally like the torrent list: once columns can
                // be widened they can exceed the panel, and without this the
                // far ones would simply be unreachable. The ListView owns
                // vertical scrolling - two of them fight.
                ScrollView {
                    viewport-width: DCols.files-total;
                    vertical-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: 0px;
                    Rectangle {
                        height: 24px;
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            for title[i] in DCols.files-titles: Rectangle {
                                width: DCols.files[i];
                                Text {
                                    text: title;
                                    font-weight: 700;
                                    font-size: 12px;
                                    x: 6px;
                                    width: parent.width - 12px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                TouchArea {
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.right
                                            && e.kind == PointerEventKind.down) {
                                            root.menu-x = self.absolute-position.x + self.mouse-x;
                                            root.menu-y = self.absolute-position.y + self.mouse-y;
                                            root.header-menu-list = 1;
                                            col-popup.show();
                                        }
                                    }
                                }
                                ColResize {
                                    current: DCols.files[i];
                                    x: parent.width - 8px;
                                    height: parent.height;
                                    resized(width) => {
                                        DCols.files-total += width - DCols.files[i];
                                        DCols.files[i] = width;
                                    }
                                    done(width) => { root.detail-column-resized(0, i, width); }
                                    fit() => { root.column-fit(1, i); }
                                }
                            }
                        }
                    }
                        Rectangle {
                            vertical-stretch: 1;
                            ListView {
                                for f[i] in root.detail-files: Rectangle {
                                    height: 22px;
                                    background: mod(i, 2) == 0 ? transparent : Palette.alternate-background;
                                    HorizontalLayout {
                                        // Indentation is the tree: Slint has no
                                        // tree widget, so depth becomes an
                                        // indent inside the name cell - it used
                                        // to be the row layout's padding, which
                                        // a fixed-width column cannot carry.
                                        DCell {
                                            w: DCols.files[0];
                                            text: f.name;
                                            bold: f.index < 0;
                                            indent: f.depth * 16px;
                                        }
                                        DCell { w: DCols.files[1]; text: f.size; align: right; }
                                        DCell {
                                            w: DCols.files[2];
                                            align: right;
                                            // Same flooring as the Progress column.
                                            text: f.index < 0
                                                ? ""
                                                : (f.progress >= 1.0
                                                    ? "100 %"
                                                    : floor(f.progress * 1000) / 10 + " %");
                                        }
                                        DCell {
                                            w: DCols.files[3];
                                            text: f.index < 0 ? "" : (f.included ? L.s(L.revision, "yes") : L.s(L.revision, "no"));
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.current-tab == 2: VerticalLayout {
                vertical-stretch: 1;
                ScrollView {
                    viewport-width: DCols.peers-total;
                    vertical-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: 0px;
                        Rectangle {
                            height: 24px;
                            background: Palette.alternate-background;
                            HorizontalLayout {
                                for title[i] in DCols.peers-titles: Rectangle {
                                    width: DCols.peers[i];
                                    Text {
                                        text: title;
                                        font-weight: 700;
                                        font-size: 12px;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    TouchArea {
                                        pointer-event(e) => {
                                            if (e.button == PointerEventButton.right
                                                && e.kind == PointerEventKind.down) {
                                                root.menu-x = self.absolute-position.x + self.mouse-x;
                                                root.menu-y = self.absolute-position.y + self.mouse-y;
                                                root.header-menu-list = 2;
                                                col-popup.show();
                                            }
                                        }
                                    }
                                    ColResize {
                                        current: DCols.peers[i];
                                        x: parent.width - 8px;
                                        height: parent.height;
                                        resized(width) => {
                                            DCols.peers-total += width - DCols.peers[i];
                                            DCols.peers[i] = width;
                                        }
                                        done(width) => { root.detail-column-resized(1, i, width); }
                                        fit() => { root.column-fit(2, i); }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            ListView {
                                for p[i] in root.detail-peers: Rectangle {
                                    height: 22px;
                                    background: mod(i, 2) == 0 ? transparent : Palette.alternate-background;
                                    HorizontalLayout {
                                        DCell { w: DCols.peers[0]; text: p.addr; }
                                        // Flag then country name, in one cell:
                                        // the flag is part of the country
                                        // column, so it has to resize with it.
                                        // The PNG is decoded on first use of
                                        // that country - see flags.rs.
                                        Rectangle {
                                            width: DCols.peers[1];
                                            Image {
                                                source: p.flag;
                                                x: 6px;
                                                width: 16px;
                                                height: 12px;
                                                image-fit: contain;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: p.country;
                                                x: 28px;
                                                width: max(0px, parent.width - 34px);
                                                height: parent.height;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        DCell { w: DCols.peers[2]; text: p.status; }
                                        DCell { w: DCols.peers[3]; text: p.downloaded; align: right; }
                                        DCell { w: DCols.peers[4]; text: p.pieces; align: right; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.current-tab == 3: VerticalLayout {
                vertical-stretch: 1;
                ScrollView {
                    viewport-width: DCols.trackers-total;
                    vertical-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: 0px;
                        Rectangle {
                            height: 24px;
                            background: Palette.alternate-background;
                            HorizontalLayout {
                                for title[i] in DCols.trackers-titles: Rectangle {
                                    width: DCols.trackers[i];
                                    Text {
                                        text: title;
                                        font-weight: 700;
                                        font-size: 12px;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    TouchArea {
                                        pointer-event(e) => {
                                            if (e.button == PointerEventButton.right
                                                && e.kind == PointerEventKind.down) {
                                                root.menu-x = self.absolute-position.x + self.mouse-x;
                                                root.menu-y = self.absolute-position.y + self.mouse-y;
                                                root.header-menu-list = 3;
                                                col-popup.show();
                                            }
                                        }
                                    }
                                    ColResize {
                                        current: DCols.trackers[i];
                                        x: parent.width - 8px;
                                        height: parent.height;
                                        resized(width) => {
                                            DCols.trackers-total += width - DCols.trackers[i];
                                            DCols.trackers[i] = width;
                                        }
                                        done(width) => { root.detail-column-resized(2, i, width); }
                                        fit() => { root.column-fit(3, i); }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            ListView {
                                for t[i] in root.detail-trackers: Rectangle {
                                    height: 22px;
                                    background: mod(i, 2) == 0 ? transparent : Palette.alternate-background;
                                    HorizontalLayout {
                                        // Tracker rows sit under their tier
                                        // heading, as the Win32 list indents
                                        // them - now an indent inside the URL
                                        // cell rather than the row's padding.
                                        DCell {
                                            w: DCols.trackers[0];
                                            text: t.url;
                                            indent: t.indented ? 18px : 0px;
                                        }
                                        DCell { w: DCols.trackers[1]; text: t.status; }
                                        DCell { w: DCols.trackers[2]; text: t.seeds; align: right; }
                                        DCell { w: DCols.trackers[3]; text: t.leeches; align: right; }
                                        DCell { w: DCols.trackers[4]; text: t.fails; align: right; }
                                        DCell { w: DCols.trackers[5]; text: t.next-announce; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- status bar ------------------------------------------------------
        if root.show-status: Rectangle {
            height: 26px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 24px;
                Text { text: L.s(L.revision, "torrents_count") + ": " + root.rows.length; vertical-alignment: center; font-size: 12px; width: 150px; }
                Text { text: L.s(L.revision, "dht_nodes_label") + ": " + root.dht-nodes; vertical-alignment: center; font-size: 12px; width: 190px; }
                Text { text: root.session-rates; vertical-alignment: center; font-size: 12px; horizontal-stretch: 1; }
                Text { text: root.status; vertical-alignment: center; font-size: 12px; color: #888; }
            }
        }
    }

    /// Transient confirmation, cleared by a timer on the Rust side. Empty
    /// means nothing to say.
    in property <string> toast;
    /// Red instead of accent. A failed add has to look different from "copied
    /// to clipboard" - both used to be the same blue pill, so the one that
    /// mattered read as confirmation.
    in property <bool> toast-error;

    // Bottom centre, above the status bar, and outside the main layout so it
    // floats rather than taking room. No TouchArea, so it never swallows a
    // click even while it is fading out.
    Rectangle {
        // Errors carry a sentence, not two words, so the pill wraps rather
        // than growing wider than the window. Capped at 560px because a
        // full-width band of text stops reading as a toast.
        property <length> limit: min(root.width - 40px, 560px);
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - (root.show-status ? 46px : 20px);
        width: min(label.preferred-width + 32px, self.limit);
        height: max(34px, label.preferred-height + 18px);
        background: root.toast-error ? #b3261e : Palette.accent-background;
        border-radius: 6px;
        opacity: root.toast == "" ? 0 : 1;
        animate opacity { duration: 150ms; }
        label := Text {
            text: root.toast;
            width: parent.width - 32px;
            wrap: word-wrap;
            // White on the red, which the accent foreground is not guaranteed
            // to be - it follows the theme's accent, and this background does
            // not.
            color: root.toast-error ? #ffffff : Palette.accent-foreground;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // The menu bar dropdowns, drawn inside the window rather than as
    // PopupWindows.
    //
    // A PopupWindow grabs the pointer, so a click on another title only
    // dismissed the open menu and never reached the title underneath - moving
    // along the bar did nothing, which is not how a menu bar behaves anywhere.
    // Drawn in-window there is no grab, so hovering switches menus the way
    // Windows does. The trade-off is that a dropdown cannot extend past the
    // window edge, which for a menu bar is not a real constraint.
    //
    // The scrim starts below the bar so the titles stay live underneath it:
    // clicking the open title closes its menu, and hovering the others
    // switches. Clicking anywhere else closes.
    if root.open-menu != 0: TouchArea {
        y: menu-bar.height;
        width: 100%;
        height: root.height - menu-bar.height;
        clicked => { root.open-menu = 0; }
    }

    if root.open-menu == 1: Rectangle {
        x: file-title.x;
        y: menu-bar.height;
        width: 240px;
        // min-height, not preferred-height: the latter resolves to 0 for a
        // layout inside an absolutely positioned Rectangle, so the panel
        // was drawn zero pixels tall and looked like it never opened.
        height: file-layout.min-height;
        background: Palette.alternate-background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        file-layout := VerticalLayout {
                padding: 4px;
                MenuRow { label: L.s(L.revision, "amp_add_torrent"); activated => { root.action("add-torrent"); root.open-menu = 0; } }
                MenuRow { label: L.s(L.revision, "add_magnet_link_s"); activated => { root.action("add-magnet"); root.open-menu = 0; } }
                MenuRow { label: L.s(L.revision, "create_torrent"); activated => { root.action("create"); root.open-menu = 0; } }
                MenuSep { }
                MenuRow { label: L.s(L.revision, "amp_exit"); activated => { root.action("exit"); root.open-menu = 0; } }
        }
    }

    if root.open-menu == 2: Rectangle {
        x: view-title.x;
        y: menu-bar.height;
        width: 260px;
        height: view-layout.min-height;
        background: Palette.alternate-background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        view-layout := VerticalLayout {
                padding: 4px;
                // Submenus expand in place. A nested PopupWindow would never
                // get its click: the outer one closes on any click outside
                // itself, the same reason the context menu does this.
                MenuRow {
                    label: L.s(L.revision, "amp_filter") + "  " + (root.filters-open ? "-" : "+");
                    activated => { root.filters-open = !root.filters-open; }
                }
                Rectangle {
                    height: root.filters-open ? root.filter-names.length * 24px : 0px;
                    clip: true;
                    VerticalLayout {
                        for f[i] in root.filter-names: MenuRow {
                            label: "    " + f;
                            activated => { root.pick-filter(i); root.open-menu = 0; }
                        }
                    }
                }
                MenuRow {
                    label: L.s(L.revision, "labels") + "  " + (root.labels-open ? "-" : "+");
                    activated => { root.labels-open = !root.labels-open; }
                }
                Rectangle {
                    height: root.labels-open ? root.label-names.length * 24px : 0px;
                    clip: true;
                    VerticalLayout {
                        for l[i] in root.label-names: MenuRow {
                            label: "    " + l;
                            activated => { root.pick-label(i); root.open-menu = 0; }
                        }
                    }
                }
                MenuSep { }
                MenuRow {
                    label: L.s(L.revision, "amp_details_panel");
                    checkable: true;
                    checked: root.show-details;
                    activated => {
                        root.show-details = !root.show-details;
                        root.view-toggled("ui.show_details_panel", root.show-details);
                        root.open-menu = 0;
                    }
                }
                MenuRow {
                    label: L.s(L.revision, "amp_status_bar");
                    checkable: true;
                    checked: root.show-status;
                    activated => {
                        root.show-status = !root.show-status;
                        root.view-toggled("ui.show_status_bar", root.show-status);
                        root.open-menu = 0;
                    }
                }
                MenuRow {
                    label: L.s(L.revision, "amp_console");
                    checkable: true;
                    checked: root.show-console;
                    activated => {
                        root.show-console = !root.show-console;
                        root.view-toggled("ui.show_console_input", root.show-console);
                        root.open-menu = 0;
                    }
                }
                MenuSep { }
                MenuRow {
                    label: L.s(L.revision, "theme") + "  " + (root.theme-open ? "-" : "+");
                    activated => { root.theme-open = !root.theme-open; }
                }
                Rectangle {
                    height: root.theme-open ? 72px : 0px;
                    clip: true;
                    VerticalLayout {
                        MenuRow {
                            label: "    " + (root.theme-id == "light" || root.theme-id == "dark" ? "   " : "\u{2713} ") + L.s(L.revision, "theme_system");
                            activated => { root.pick-theme("system"); root.open-menu = 0; }
                        }
                        MenuRow {
                            label: "    " + (root.theme-id == "light" ? "\u{2713} " : "   ") + L.s(L.revision, "theme_light");
                            activated => { root.pick-theme("light"); root.open-menu = 0; }
                        }
                        MenuRow {
                            label: "    " + (root.theme-id == "dark" ? "\u{2713} " : "   ") + L.s(L.revision, "theme_dark");
                            activated => { root.pick-theme("dark"); root.open-menu = 0; }
                        }
                    }
                }
                MenuSep { }
                MenuRow { label: L.s(L.revision, "preferences"); activated => { root.action("preferences"); root.open-menu = 0; } }
        }
    }

    // A plugin's own dropdown. One declaration serves every plugin: only one
    // is open at a time, and `plugin-menu-x` says which title it hangs under.
    if root.open-menu == 4: Rectangle {
        x: root.plugin-menu-x;
        y: menu-bar.height;
        width: 240px;
        height: plugin-menu-layout.min-height;
        background: Palette.alternate-background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        plugin-menu-layout := VerticalLayout {
            padding: 4px;
            for entry in root.plugin-menu-items: MenuRow {
                label: entry.label;
                activated => { root.activate-plugin-menu(entry.id); root.open-menu = 0; }
            }
        }
    }

    if root.open-menu == 3: Rectangle {
        x: help-title.x;
        y: menu-bar.height;
        width: 220px;
        height: help-layout.min-height;
        background: Palette.alternate-background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        help-layout := VerticalLayout {
                padding: 4px;
                MenuRow { label: L.s(L.revision, "documentation"); activated => { root.action("docs"); root.open-menu = 0; } }
                MenuRow { label: L.s(L.revision, "command_line_help"); activated => { root.action("cli-help"); root.open-menu = 0; } }
                MenuRow { label: L.s(L.revision, "amp_check_for_update"); activated => { root.action("check-update"); root.open-menu = 0; } }
                MenuRow { label: L.s(L.revision, "amp_about"); activated => { root.action("about"); root.open-menu = 0; } }
        }
    }

    // Modal guard. On Windows EnableWindow already makes the window inert, so
    // this is the portable half: it swallows clicks wherever that call is not
    // available. Transparent on purpose - a dimming scrim would be a different
    // look from the Win32 dialogs this replaces.
    if root.blocked: TouchArea {
        width: 100%;
        height: 100%;
    }
}


// Add-magnet dialog. A separate Window rather than an in-window overlay, which
// is what the platform expects of a dialog.
export component AddMagnetDialog inherits Window {
    icon: @image-url("../../res/app.png");
    title: L.s(L.revision, "add_magnet_link_s");
    preferred-width: 560px;
    preferred-height: min(300px, root.screen-limit);
    background: Palette.background;
    /// The tallest this window may be, in logical pixels - set from the
    /// monitor work area. Huge by default so a build that cannot read it
    /// behaves as if unclamped.
    in property <length> screen-limit: 100000px;
    max-height: root.screen-limit;

    in-out property <string> links;
    callback accepted();
    callback cancelled();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Text {
            text: L.s(L.revision, "add_magnet_link_s_description");
            font-size: 13px;
            color: Palette.foreground;
        }

        TextEdit {
            vertical-stretch: 1;
            text <=> root.links;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: L.s(L.revision, "cancel");
                clicked => { root.cancelled(); }
            }
            Button {
                text: L.s(L.revision, "add");
                primary: true;
                clicked => { root.accepted(); }
            }
        }
    }
}


/// One torrent waiting in a multi-file add. The file list belongs to whichever
/// of these is selected, so this only carries what the queue column shows.
export struct QueueRow {
    name: string,
    size: string,
}

export struct FileRow {
    /// Index into the torrent's file list, or -1 for a folder row.
    index: int,
    depth: int,
    name: string,
    size: string,
    included: bool,
}

// Add-torrent dialog: parsed file list, save path, label and start toggle.
export component AddTorrentDialog inherits Window {
    icon: @image-url("../../res/app.png");
    title: L.s(L.revision, "add_torrent_s");
    preferred-width: 640px;
    preferred-height: min(540px, root.screen-limit);
    background: Palette.background;
    /// The tallest this window may be, in logical pixels - set from the
    /// monitor work area. Huge by default so a build that cannot read it
    /// behaves as if unclamped.
    in property <length> screen-limit: 100000px;
    max-height: root.screen-limit;

    in property <string> torrent-name;
    in property <string> torrent-size;
    in-out property <string> save-path;
    in-out property <bool> start-torrent: true;
    in property <[FileRow]> files;

    /// Every torrent in this batch. One entry for a single add, in which case
    /// the queue column is hidden and the dialog looks exactly as it did.
    in property <[QueueRow]> queue;
    in-out property <int> selected-torrent;

    callback accepted();
    callback cancelled();
    callback browse();
    callback toggle-file(int);
    callback select-torrent(int);

    /// Width of the queue column. Rust seeds it from the last time and stores
    /// it again when a drag ends - a batch add is short-lived, so re-dragging
    /// it on every add would be the whole interaction.
    in-out property <length> queue-width: 200px;
    callback queue-width-changed(length);
    private property <length> queue-drag-start;
    private property <length> queue-drag-x;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            Text { text: L.s(L.revision, "save_to"); font-weight: 700; font-size: 13px; width: 90px; vertical-alignment: center; }
            LineEdit {
                text <=> root.save-path;
                horizontal-stretch: 1;
                placeholder-text: L.s(L.revision, "server_default");
            }
            Button { text: L.s(L.revision, "browse"); clicked => { root.browse(); } }
        }

        CheckBox {
            text: L.s(L.revision, "start_torrent");
            checked <=> root.start-torrent;
        }

        HorizontalLayout {
        spacing: 10px;

        // The queue column, only when there is a queue. A single add keeps the
        // original full-width layout rather than growing an empty sidebar.
        if root.queue.length > 1: Rectangle {
            width: root.queue-width;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;

            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 26px;
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text {
                            text: L.s(L.revision, "torrents") + " (\{root.queue.length})";
                            font-weight: 700;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
                ListView {
                    for q[i] in root.queue: Rectangle {
                        height: 38px;
                        background: i == root.selected-torrent
                            ? Palette.accent-background
                            : (mod(i, 2) == 0 ? transparent : Palette.alternate-background);
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select-torrent(i); }
                        }
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: q.name;
                                font-size: 12px;
                                overflow: elide;
                                color: i == root.selected-torrent
                                    ? Palette.accent-foreground
                                    : Palette.foreground;
                            }
                            Text {
                                text: q.size;
                                font-size: 11px;
                                color: i == root.selected-torrent
                                    ? Palette.accent-foreground
                                    : #888;
                            }
                        }
                    }
                }
            }
        }

        if root.queue.length > 1: VDivider {
            grabbed(x) => {
                root.queue-drag-start = root.queue-width;
                root.queue-drag-x = x;
            }
            dragged(x) => {
                // Floor keeps the names readable; ceiling keeps the file tree
                // on the right from being squeezed out of its own dialog.
                root.queue-width = min(
                    max(root.queue-drag-start + (x - root.queue-drag-x), 120px),
                    max(140px, root.width - 320px));
            }
            released => { root.queue-width-changed(root.queue-width); }
        }

        VerticalLayout {
        spacing: 8px;
        horizontal-stretch: 1;

        GridLayout {
            spacing: 8px;
            Row {
                Text { text: L.s(L.revision, "name"); font-weight: 700; font-size: 13px; width: 90px; vertical-alignment: center; }
                Text { text: root.torrent-name; font-size: 13px; overflow: elide; vertical-alignment: center; }
            }
            Row {
                Text { text: L.s(L.revision, "size"); font-weight: 700; font-size: 13px; width: 90px; vertical-alignment: center; }
                Text { text: root.torrent-size; font-size: 13px; vertical-alignment: center; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;

            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 26px;
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        Text { text: L.s(L.revision, "include"); font-weight: 700; font-size: 12px; width: 70px; vertical-alignment: center; }
                        Text { text: L.s(L.revision, "name"); font-weight: 700; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: L.s(L.revision, "size"); font-weight: 700; font-size: 12px; width: 100px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
                ListView {
                    for f[i] in root.files: Rectangle {
                        height: 24px;
                        background: mod(i, 2) == 0 ? transparent : Palette.alternate-background;
                        HorizontalLayout {
                            // Depth becomes indentation, the same tree the
                            // details Files tab draws.
                            padding-left: 8px + f.depth * 16px;
                            padding-right: 8px;
                            spacing: 12px;
                            // Folder rows have nothing to include: their
                            // files each carry their own checkbox.
                            if f.index >= 0: CheckBox {
                                width: 70px;
                                checked: f.included;
                                toggled => { root.toggle-file(i); }
                            }
                            if f.index < 0: Rectangle { width: 70px; }
                            DataText {
                                text: f.name;
                                horizontal-stretch: 1;
                                bold: f.index < 0;
                            }
                            DataText { text: f.size; width: 100px; align: right; }
                        }
                    }
                }
            }
        }

        }
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: L.s(L.revision, "cancel"); clicked => { root.cancelled(); } }
            // Says how many when it is more than one, so nobody presses Add
            // thinking it only takes the torrent currently on screen.
            Button {
                text: root.queue.length > 1
                    ? L.s(L.revision, "add") + " (\{root.queue.length})"
                    : L.s(L.revision, "add");
                primary: true;
                clicked => { root.accepted(); }
            }
        }
    }
}
