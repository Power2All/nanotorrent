// Globals shared by every window: the translation lookup, the clipboard, the
// screen clamp, the hover-tip body and the dialog base. Kept out of app.slint because app.slint imports the
// dialogs, so anything they both need cannot live there.

import { Palette } from "std-widgets.slint";

// Copying a detail value to the clipboard. A global rather than a callback
// threaded through every list row: the cells below are several layers deep and
// each one would otherwise need wiring at its use site.
export global Clip {
    callback copy(string);
}

// Translated UI strings, looked up by the same keys lang/*.json uses.
//
// A callback rather than one property per string: there are ~100 of them, and a
// property each would be 100 declarations plus 100 setters in Rust. Bindings
// that call it are re-evaluated when `revision` changes, which is how a
// language change reaches every caption without a restart.
export global L {
    /// Bumped whenever the language changes. Every `s()` call passes it so the
    /// binding depends on it and re-evaluates - without that the captions are
    /// computed once at startup and switching language does nothing until the
    /// app is restarted.
    in property <int> revision;
    pure callback s(int, string) -> string;
}

// The tallest a dialog may be, in logical pixels - set from the monitor work
// area by `clamp_to_screen` in mod.rs. Huge by default so a build that cannot
// read it (or a platform where it is not wired up) behaves as if unclamped.
//
// A global rather than a property on `Dialog`: a base component's properties
// are not exposed to Rust, and a global is per window anyway, like `L`.
export global Screen {
    in property <length> limit: 100000px;
}

// What every dialog window shares: the app icon on its title bar, and the
// palette's background behind its content.
export component Dialog inherits Window {
    icon: @image-url("../../res/app-256.png");
    background: Palette.background;
}

// What a hover tip shows: one line of text in a bordered box. The content of
// a `Tooltip`, shared so every tip in the app looks the same.
export component TipBox inherits Rectangle {
    in property <string> text;
    /// For a tip that is a sentence rather than a name: it wraps, rather than
    /// running off the screen, and gets a little more room around it.
    in property <bool> wrap;
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 4px;
    HorizontalLayout {
        padding: root.wrap ? 8px : 6px;
        Text {
            text: root.text;
            font-size: 12px;
            color: Palette.foreground;
            wrap: root.wrap ? word-wrap : no-wrap;
            // Wide enough for a sentence, narrow enough to stay beside the
            // control. Unbounded otherwise, as a Text is by default.
            max-width: root.wrap ? 320px : 100000px;
        }
    }
}
