// Confirming something that cannot be undone.
//
// Every way of removing a torrent comes through here - the Delete key, the
// toolbar's trash button and both context-menu entries - and so does changing
// or removing a tracker. They want the same shape: a question, what it acts
// on, one or two actions, and a box that stops it asking next time. Only the
// wording differs, so the wording is a property rather than three dialogs. It used to be only the
// first of those, on the reasoning that "Remove torrent and files" already
// says what it will do and a prompt on top of it is a second click. That
// reasoning holds right up until the click was a mis-click, and this is the
// one action in the window that can destroy a finished download, so it now
// asks whichever way it was reached.
//
// Two buttons rather than a checkbox: "remove" and "remove and erase the data"
// are different acts, one of them irreversible, and a ticked box is easy to
// miss on the way to a button that reads the same either way. That is also why
// the menu entry you picked does not preselect one here - the dialog states
// both outcomes and makes you choose again.

import { ScrollView, Button, CheckBox, Palette } from "std-widgets.slint";
import { L } from "globals.slint";

export component RemoveDialog inherits Window {
    icon: @image-url("../../res/app-256.png");
    title: L.s(L.revision, "remove_torrent");
    // Width is pinned - nothing here reflows horizontally. Height is NOT:
    // the window takes its content's natural height, so it opens exactly
    // fitting and shows no scrollbar. Capping it instead meant a cap even a
    // few pixels under the content left the scrollbar up permanently.
    // min-height only sets how far it may be dragged down on a screen too
    // short for it - that is when the ScrollView earns its keep.
    min-width: 500px;
    max-width: 500px;
    // min == max, both bound to the limit: binding only max leaves an
    // already-shown window at its old height, because nothing forces a
    // re-layout. This is the shape the Preferences dialog uses.
    min-height: min(body.preferred-height, root.screen-limit);
    /// The tallest this window may be, in logical pixels - set from the
    /// monitor work area. Huge by default so a build that cannot read it
    /// behaves as if unclamped.
    in property <length> screen-limit: 100000px;
    max-height: min(body.preferred-height, root.screen-limit);
    background: Palette.background;

    /// The question, already worded by the caller.
    in property <string> heading;
    /// What it acts on: one torrent's name, "N torrents", a tracker's URL.
    in property <string> subject;
    /// The grey line under it. Empty draws none.
    in property <string> note;

    /// The safe action's caption. Always drawn.
    in property <string> primary-text;
    /// The second, less safe action - "and delete the files". Empty means
    /// there is only one thing this can do, which is the case whenever the
    /// caller already knows which was meant.
    in property <string> secondary-text;

    /// Whether to offer "do not ask again". Off where there is nothing
    /// sensible to remember.
    in property <bool> offer-remember: true;

    /// `(secondary, remember)` - which action, and whether to stop asking.
    callback chosen(bool, bool);
    callback cancelled();

    /// The checkbox's state, kept here so either button can read it.
    property <bool> remember: false;

    // Esc cancels, as in every other dialog here. Deliberately no Enter
    // binding: neither option should be reachable by a stray keypress.
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    // Scrolls rather than clipping when the clamp above wins on a
    // screen too short for the content.
    ScrollView {
        vertical-scrollbar-policy: as-needed;
        body := VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Text {
                text: root.heading;
                font-size: 13px;
                font-weight: 700;
                color: Palette.foreground;
                wrap: word-wrap;
            }

            if root.subject != "": Text {
                text: root.subject;
                font-size: 13px;
                color: Palette.foreground;
                wrap: word-wrap;
                overflow: elide;
            }

            if root.note != "": Text {
                text: root.note;
                font-size: 12px;
                color: #888;
                wrap: word-wrap;
            }

            // Unticked every time it is shown. A box that remembers its own
            // last answer would turn a deliberate "just this once" into a
            // standing instruction the next time somebody was not reading.
            if root.offer-remember: CheckBox {
                text: L.s(L.revision, "dont_ask_again");
                checked: false;
                toggled => { root.remember = self.checked; }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: L.s(L.revision, "cancel");
                    clicked => { root.cancelled(); }
                }
                // The irreversible one is not primary: the safe choice is the one
                // under the cursor's resting place and the one Enter would reach
                // if Enter were bound.
                if root.secondary-text != "": Button {
                    text: root.secondary-text;
                    clicked => { root.chosen(true, root.remember); }
                }
                Button {
                    text: root.primary-text;
                    primary: true;
                    clicked => { root.chosen(false, root.remember); }
                }
            }
        }
    }
}
