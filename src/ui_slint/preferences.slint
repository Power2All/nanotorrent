// Preferences.
//
// Same four tabs and the same settings, so the two UIs configure one app
// rather than two. Compare against docs/ui-baseline/07-prefs-*.png.
//
// Every value is an in-out property: Rust fills them when the dialog opens and
// reads them back on Ok. Nothing is written to the database as it is typed -
// the Win32 dialog applies on Ok too, and a half-edited port number should not
// take effect the moment a digit lands.

import { TabWidget, Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, Palette } from "std-widgets.slint";
import { L } from "globals.slint";

// A left-aligned bold caption with its control beside it, which is the shape
// almost every row in this dialog takes.
/// A label or a saved filter, as the list edits it. `id` is -1 for a row that
/// has not been saved yet, which is what the upsert calls treat as an insert.
export struct NamedRule {
    id: int,
    name: string,
    /// The PQL expression for a filter, or a label's save path.
    rule: string,
}

component Labelled inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 190px;
    spacing: 10px;
    Text {
        text: root.label;
        font-weight: 700;
        font-size: 13px;
        width: root.label-width;
        vertical-alignment: center;
    }
    @children
}

export component PreferencesDialog inherits Window {
    icon: @image-url("../../res/app.png");
    title: L.s(L.revision, "preferences");
    // Width is pinned - nothing here reflows horizontally. Height is NOT:
    // the window takes its content's natural height, so it opens exactly
    // fitting and shows no scrollbar. Capping it instead meant a cap even a
    // few pixels under the content left the scrollbar up permanently.
    // min-height only sets how far it may be dragged down on a screen too
    // short for it - that is when the ScrollView earns its keep.
    // The TabWidget's height is the tallest tab (Connection), so every other
    // tab carries some empty space - that is inherent to a tabbed dialog and
    // was true when the height was hard-coded too.
    min-width: 700px;
    max-width: 700px;
    /// The tallest this window may be, in logical pixels - set from the
    /// monitor work area. Huge by default so a build that cannot read it (or
    /// a platform where it is not wired up) behaves as if unclamped.
    in property <length> screen-limit: 100000px;
    // min == max, so the window is not resizable at all.
    //
    // Height = the tallest tab's content, plus the tab bar, the footer and the
    // padding around them - then clamped to what the screen can show.
    //
    // It is summed from the tab BODIES (tb1..tb5) rather than from the
    // TabWidget or the outer layout, because each body now sits in its own
    // ScrollView and a ScrollView reports `preferred-height: 100%` with a 50px
    // floor - it deliberately does not pass its content's size up. Measuring
    // anything above the bodies collapsed the window (336px, then 729px).
    //
    // So on a screen with room, the window is exactly tall enough for the
    // tallest tab and nothing scrolls. On a short screen the clamp wins and
    // the tab CONTENT scrolls - the tab bar and the footer stay put, because
    // both are outside the per-tab ScrollViews.
    property <length> tallest-tab: max(tb1.preferred-height,
        max(tb2.preferred-height,
        max(tb3.preferred-height,
        max(tb4.preferred-height,
        max(tb5.preferred-height, tb6.preferred-height)))));
    // Tab bar, footer row, and the 12px padding top and bottom plus 10px
    // between the tabs and the footer.
    property <length> chrome: 40px + foot.preferred-height + 34px;
    min-height: min(self.tallest-tab + self.chrome, root.screen-limit);
    max-height: min(self.tallest-tab + self.chrome, root.screen-limit);
    background: Palette.background;

    // --- General ---------------------------------------------------------
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <[string]> themes;
    in-out property <int> theme-index;
    in-out property <bool> skip-add-dialog;
    in-out property <bool> show-in-tray;
    in property <[string]> close-actions;
    in-out property <int> close-action-index;
    in-out property <bool> minimize-to-tray;
    in-out property <bool> notify-complete;
    in-out property <bool> check-updates;
    /// File associations are a Windows concept; the button hides elsewhere.
    in property <bool> can-associate;

    // --- Downloads -------------------------------------------------------
    in-out property <string> save-path;
    in-out property <bool> pause-on-low-disk;
    in-out property <string> low-disk-limit;
    in-out property <string> active-limit;
    in-out property <string> active-downloads;
    in-out property <string> active-seeds;
    in-out property <bool> limit-download;
    in-out property <string> download-limit;
    in-out property <bool> limit-upload;
    in-out property <string> upload-limit;

    // --- Connection ------------------------------------------------------
    in-out property <string> listen-address;
    in-out property <string> listen-port;
    in-out property <bool> enable-dht;
    in-out property <bool> enable-lsd;
    in-out property <bool> enable-pex;
    in-out property <bool> enable-geoip;
    in-out property <bool> enable-ipfilter;
    in-out property <string> ipfilter-path;
    in-out property <bool> require-outgoing-encryption;
    in-out property <bool> require-incoming-encryption;
    in-out property <bool> anonymous-mode;

    // --- Proxy -----------------------------------------------------------
    in property <[string]> proxy-types;
    in-out property <int> proxy-type-index;
    in-out property <string> proxy-host;
    in-out property <string> proxy-port;
    in-out property <bool> proxy-hostnames;
    in-out property <bool> proxy-peers;
    in-out property <bool> proxy-trackers;

    callback accepted();
    callback cancelled();
    callback browse-save-path();
    callback browse-ipfilter();
    callback set-associations();

    // --- Labels & filters -------------------------------------------------
    in property <[NamedRule]> labels;
    in property <[NamedRule]> filters;
    in-out property <int> label-index: -1;
    in-out property <int> filter-index: -1;
    // Edited in place by the fields below and committed by save-label /
    // save-filter, so a half-typed name never reaches the database.
    in-out property <string> edit-label-name;
    in-out property <string> edit-label-path;
    in-out property <string> edit-filter-name;
    in-out property <string> edit-filter-rule;
    // False while the expression does not parse - the same signal the console
    // gives, and Save stays disabled until it does.
    in property <bool> filter-valid: true;
    callback pick-label(int);
    callback pick-filter(int);
    callback save-label();
    callback delete-label();
    callback save-filter();
    callback delete-filter();
    callback filter-rule-changed(string);
    callback browse-label-path();

    // --- Web interface ----------------------------------------------------
    in-out property <bool> web-enabled;
    in-out property <string> web-bind;
    in-out property <string> web-port;
    in-out property <string> web-username;
    /// Typed fresh each time; never populated from the stored hash, which
    /// cannot be reversed. Empty on Ok means "leave the existing one alone".
    in-out property <string> web-password;
    in property <bool> web-password-set;
    in property <[string]> web-tls-modes;
    in-out property <int> web-tls-index;
    in-out property <string> web-cert-path;
    in-out property <string> web-key-path;
    /// Filled in by Rust: why the current combination would be refused at
    /// startup, or empty when it is fine.
    in property <string> web-warning;
    /// What the running server is doing, filled in by Rust.
    in property <string> web-status;
    in property <bool> web-status-ok;
    // Actix tuning, hidden behind the toggle. Strings and not ints because
    // these are LineEdits: an int property would coerce a half-typed or empty
    // field to 0 mid-edit, and 0 is a meaningful value for two of them.
    // Rust parses and clamps on save.
    in-out property <bool> web-advanced;
    in-out property <string> web-req-timeout;
    in-out property <string> web-disconnect-timeout;
    in-out property <string> web-keep-alive;
    in-out property <string> web-max-connections;
    in-out property <string> web-max-conn-rate;
    in-out property <string> web-workers;
    in-out property <string> web-shutdown-timeout;
    in-out property <string> web-max-body;
    /// Put the eight tuning fields back to the values `Advanced::default()`
    /// holds. Only the fields - the write still happens on OK, so this is as
    /// undoable as any other edit in the dialog.
    callback web-advanced-reset();
    callback browse-web-cert();
    callback browse-web-key();
    callback web-changed();
    // Writable so a failed Ok can bring the Web interface tab back to the
    // front - the error it reports is on that tab, and pressing Ok from any
    // other one would otherwise leave the dialog open with no visible reason.
    in-out property <int> current-tab <=> tabs.current-index;

    body := VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // The tab BAR must never scroll - scrolling it away leaves no way to
        // change tab. So the scrolling happens inside each Tab instead, and
        // the widget itself just fills what height the window has. The footer
        // below is outside all of it and is always reachable.
        tabs := TabWidget {
        vertical-stretch: 1;

            Tab {
                title: L.s(L.revision, "general");
                ScrollView {
                    vertical-scrollbar-policy: as-needed;
                    tb1 := VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Labelled {
                            // A ComboBox, not the 160px list this used to be: with
                            // ~50 locales the list could never show enough of them
                            // to be worth the height, and it made the tab tall
                            // enough to leave the rest of the dialog empty.
                            label: L.s(L.revision, "language");
                            ComboBox {
                                model: root.languages;
                                current-index <=> root.language-index;
                                width: 220px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Labelled {
                            label: L.s(L.revision, "theme");
                            ComboBox {
                                model: root.themes;
                                current-index <=> root.theme-index;
                                width: 220px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        CheckBox { text: L.s(L.revision, "skip_add_torrent_dialog"); checked <=> root.skip-add-dialog; }
                        CheckBox { text: L.s(L.revision, "show_picotorrent_in_notification_area"); checked <=> root.show-in-tray; }

                        Labelled {
                            label: L.s(L.revision, "close_action_label");
                            ComboBox {
                                model: root.close-actions;
                                current-index <=> root.close-action-index;
                                width: 220px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        CheckBox { text: L.s(L.revision, "minimize_to_notification_area"); checked <=> root.minimize-to-tray; }
                        CheckBox { text: L.s(L.revision, "notify_download_complete"); checked <=> root.notify-complete; }
                        CheckBox { text: L.s(L.revision, "check_for_updates_on_start"); checked <=> root.check-updates; }

                        if root.can-associate: HorizontalLayout {
                            Button {
                                text: L.s(L.revision, "set_default_associations");
                                clicked => { root.set-associations(); }
                            }
                            // Keeps the button its natural width instead of
                            // stretching it across the dialog.
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Tab {
                title: L.s(L.revision, "downloads");
                ScrollView {
                    vertical-scrollbar-policy: as-needed;
                    tb2 := VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Labelled {
                            label: L.s(L.revision, "save_path");
                            LineEdit { text <=> root.save-path; horizontal-stretch: 1; }
                            Button { text: L.s(L.revision, "browse"); clicked => { root.browse-save-path(); } }
                        }

                        CheckBox {
                            text: L.s(L.revision, "pause_on_low_disk_space");
                            checked <=> root.pause-on-low-disk;
                        }
                        Labelled {
                            label: "    " + L.s(L.revision, "pause_on_low_disk_space_limit");
                            LineEdit { text <=> root.low-disk-limit; width: 100px; enabled: root.pause-on-low-disk; }
                            Text { text: "%"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Labelled {
                            label: L.s(L.revision, "active_limit");
                            LineEdit { text <=> root.active-limit; width: 100px; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: L.s(L.revision, "active_downloads");
                            LineEdit { text <=> root.active-downloads; width: 100px; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: L.s(L.revision, "active_seeds");
                            LineEdit { text <=> root.active-seeds; width: 100px; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        CheckBox { text: L.s(L.revision, "enable_dl_rate_limit"); checked <=> root.limit-download; }
                        Labelled {
                            label: "    " + L.s(L.revision, "dl_rate_limit");
                            LineEdit { text <=> root.download-limit; width: 100px; enabled: root.limit-download; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        CheckBox { text: L.s(L.revision, "enable_ul_rate_limit"); checked <=> root.limit-upload; }
                        Labelled {
                            label: "    " + L.s(L.revision, "ul_rate_limit");
                            LineEdit { text <=> root.upload-limit; width: 100px; enabled: root.limit-upload; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Tab {
                title: L.s(L.revision, "connection");
                ScrollView {
                    vertical-scrollbar-policy: as-needed;
                    tb3 := VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Labelled {
                            label: L.s(L.revision, "listen_interface");
                            LineEdit { text <=> root.listen-address; horizontal-stretch: 1; }
                            LineEdit { text <=> root.listen-port; width: 110px; }
                        }

                        CheckBox { text: L.s(L.revision, "enable_dht"); checked <=> root.enable-dht; }
                        CheckBox {
                            // No librqbit 8 equivalent, so the value round-trips but
                            // never reaches the session. Disabled rather than left
                            // looking functional - same as the Win32 dialog.
                            text: L.s(L.revision, "enable_lsd_unavailable");
                            checked <=> root.enable-lsd;
                            enabled: false;
                        }
                        CheckBox { text: L.s(L.revision, "enable_pex"); checked <=> root.enable-pex; }
                        CheckBox { text: L.s(L.revision, "resolve_peer_countries"); checked <=> root.enable-geoip; }

                        CheckBox { text: L.s(L.revision, "ip_filter"); checked <=> root.enable-ipfilter; }
                        Labelled {
                            label: "    " + L.s(L.revision, "filter_file");
                            LineEdit { text <=> root.ipfilter-path; horizontal-stretch: 1; enabled: root.enable-ipfilter; }
                            Button { text: L.s(L.revision, "browse"); enabled: root.enable-ipfilter; clicked => { root.browse-ipfilter(); } }
                        }

                        CheckBox { text: L.s(L.revision, "require_encryption_outgoing"); checked <=> root.require-outgoing-encryption; }
                        CheckBox { text: L.s(L.revision, "require_encryption_incoming"); checked <=> root.require-incoming-encryption; }
                        CheckBox { text: L.s(L.revision, "anonymous_mode"); checked <=> root.anonymous-mode; }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Tab {
                title: L.s(L.revision, "proxy");
                ScrollView {
                    vertical-scrollbar-policy: as-needed;
                    tb4 := VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Labelled {
                            label: L.s(L.revision, "type");
                            ComboBox {
                                model: root.proxy-types;
                                current-index <=> root.proxy-type-index;
                                width: 220px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: L.s(L.revision, "host");
                            LineEdit { text <=> root.proxy-host; horizontal-stretch: 1; enabled: root.proxy-type-index > 0; }
                            LineEdit { text <=> root.proxy-port; width: 110px; enabled: root.proxy-type-index > 0; }
                        }

                        CheckBox { text: L.s(L.revision, "proxy_hostnames"); checked <=> root.proxy-hostnames; enabled: root.proxy-type-index > 0; }
                        CheckBox { text: L.s(L.revision, "proxy_peers"); checked <=> root.proxy-peers; enabled: root.proxy-type-index > 0; }
                        CheckBox { text: L.s(L.revision, "proxy_trackers"); checked <=> root.proxy-trackers; enabled: root.proxy-type-index > 0; }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Tab {
                title: L.s(L.revision, "web_interface");
                ScrollView {
                    vertical-scrollbar-policy: as-needed;
                    tb5 := VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        CheckBox {
                            text: L.s(L.revision, "enable_web_interface");
                            checked <=> root.web-enabled;
                            toggled => { root.web-changed(); }
                        }
                        Labelled {
                            label: L.s(L.revision, "listen_interface");
                            LineEdit {
                                text <=> root.web-bind;
                                horizontal-stretch: 1;
                                enabled: root.web-enabled;
                                edited => { root.web-changed(); }
                            }
                            LineEdit {
                                text <=> root.web-port;
                                width: 110px;
                                enabled: root.web-enabled;
                                edited => { root.web-changed(); }
                            }
                        }
                        Labelled {
                            label: L.s(L.revision, "username");
                            LineEdit { text <=> root.web-username; horizontal-stretch: 1; enabled: root.web-enabled; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: L.s(L.revision, "password");
                            LineEdit {
                                text <=> root.web-password;
                                input-type: password;
                                horizontal-stretch: 1;
                                enabled: root.web-enabled;
                                // Says whether one is already stored without
                                // implying the box should show it - the hash
                                // cannot be turned back into a password.
                                placeholder-text: root.web-password-set
                                    ? L.s(L.revision, "password_unchanged")
                                    : L.s(L.revision, "password_required");
                                edited => { root.web-changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: L.s(L.revision, "tls");
                            ComboBox {
                                model: root.web-tls-modes;
                                current-index <=> root.web-tls-index;
                                width: 220px;
                                enabled: root.web-enabled;
                                selected => { root.web-changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: "    " + L.s(L.revision, "certificate");
                            LineEdit {
                                text <=> root.web-cert-path;
                                horizontal-stretch: 1;
                                // Only meaningful for the custom mode; index 1.
                                enabled: root.web-enabled && root.web-tls-index == 1;
                                edited => { root.web-changed(); }
                            }
                            Button {
                                text: L.s(L.revision, "browse");
                                enabled: root.web-enabled && root.web-tls-index == 1;
                                clicked => { root.browse-web-cert(); }
                            }
                        }
                        Labelled {
                            label: "    " + L.s(L.revision, "private_key");
                            LineEdit {
                                text <=> root.web-key-path;
                                horizontal-stretch: 1;
                                enabled: root.web-enabled && root.web-tls-index == 1;
                                edited => { root.web-changed(); }
                            }
                            Button {
                                text: L.s(L.revision, "browse");
                                enabled: root.web-enabled && root.web-tls-index == 1;
                                clicked => { root.browse-web-key(); }
                            }
                        }

                        // The server refuses these combinations at startup rather
                        // than warning, so say so here instead of letting someone
                        // press Ok and find the interface silently absent.
                        Text {
                            text: root.web-warning;
                            color: #f2705f;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                        // What the server is actually doing: the address it is
                        // listening on, or why it is not. Set after Ok restarts
                        // it, so this reports the real outcome rather than a
                        // promise about one.
                        Text {
                            text: root.web-status;
                            font-size: 12px;
                            color: root.web-status-ok ? #7bb87b : #888;
                            wrap: word-wrap;
                        }

                        // Collapsed by default: these are actix internals, and
                        // the defaults are right for the machine-local case
                        // this interface is normally used in. Anyone who needs
                        // them knows to look; anyone who does not should not
                        // meet eight timeout fields on the way to the password.
                        CheckBox {
                            text: L.s(L.revision, "web_advanced");
                            checked <=> root.web-advanced;
                        }
                        if root.web-advanced: VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: L.s(L.revision, "web_advanced_hint");
                                font-size: 12px;
                                color: #888;
                                wrap: word-wrap;
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_request_timeout");
                                LineEdit {
                                    text <=> root.web-req-timeout;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_disconnect_timeout");
                                LineEdit {
                                    text <=> root.web-disconnect-timeout;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_keep_alive");
                                LineEdit {
                                    text <=> root.web-keep-alive;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_shutdown_timeout");
                                LineEdit {
                                    text <=> root.web-shutdown-timeout;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_max_connections");
                                LineEdit {
                                    text <=> root.web-max-connections;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_max_conn_rate");
                                LineEdit {
                                    text <=> root.web-max-conn-rate;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_workers");
                                LineEdit {
                                    text <=> root.web-workers;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            Labelled {
                                label: "    " + L.s(L.revision, "web_max_body");
                                LineEdit {
                                    text <=> root.web-max-body;
                                    horizontal-stretch: 1;
                                    input-type: number;
                                    enabled: root.web-enabled;
                                    edited => { root.web-changed(); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 190px;
                                Button {
                                    text: L.s(L.revision, "web_advanced_reset");
                                    enabled: root.web-enabled;
                                    clicked => { root.web-advanced-reset(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Tab {
                title: L.s(L.revision, "labels_and_filters");
                // Labels left, filters right: two small list-plus-editor panes
                // rather than a tab each, which would bury one of them.
                //
                // No ScrollView around this one: both panes are ListViews that
                // scroll themselves. It still has to count towards the window
                // height below, or the window would be too short for it.
                tb6 := HorizontalLayout {
                    padding: 12px;
                    spacing: 16px;

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text { text: L.s(L.revision, "labels"); font-weight: 700; font-size: 13px; }
                        Rectangle {
                            vertical-stretch: 1;
                            border-color: Palette.border;
                            border-width: 1px;
                            border-radius: 4px;
                            ListView {
                                for l[i] in root.labels: Rectangle {
                                    height: 26px;
                                    background: i == root.label-index
                                        ? Palette.selection-background
                                        : transparent;
                                    TouchArea { clicked => { root.pick-label(i); } }
                                    Text {
                                        text: l.name;
                                        x: 8px;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        color: i == root.label-index
                                            ? Palette.selection-foreground
                                            : Palette.foreground;
                                    }
                                }
                            }
                        }
                        Labelled {
                            label: L.s(L.revision, "name");
                            label-width: 90px;
                            LineEdit { text <=> root.edit-label-name; horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: L.s(L.revision, "save_path");
                            label-width: 90px;
                            LineEdit { text <=> root.edit-label-path; horizontal-stretch: 1; }
                            Button { text: L.s(L.revision, "browse"); clicked => { root.browse-label-path(); } }
                        }
                        // Nothing to say here, but the right pane has a
                        // validation message in this slot - without a matching
                        // row its list ends higher and the buttons below stop
                        // lining up.
                        Rectangle { height: 16px; }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: L.s(L.revision, "delete");
                                enabled: root.label-index >= 0;
                                clicked => { root.delete-label(); }
                            }
                            Button {
                                text: L.s(L.revision, "save");
                                primary: true;
                                enabled: root.edit-label-name != "";
                                clicked => { root.save-label(); }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text { text: L.s(L.revision, "amp_filter"); font-weight: 700; font-size: 13px; }
                        Rectangle {
                            vertical-stretch: 1;
                            border-color: Palette.border;
                            border-width: 1px;
                            border-radius: 4px;
                            ListView {
                                for f[i] in root.filters: Rectangle {
                                    height: 26px;
                                    background: i == root.filter-index
                                        ? Palette.selection-background
                                        : transparent;
                                    TouchArea { clicked => { root.pick-filter(i); } }
                                    Text {
                                        text: f.name;
                                        x: 8px;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        color: i == root.filter-index
                                            ? Palette.selection-foreground
                                            : Palette.foreground;
                                    }
                                }
                            }
                        }
                        Labelled {
                            label: L.s(L.revision, "name");
                            label-width: 90px;
                            LineEdit { text <=> root.edit-filter-name; horizontal-stretch: 1; }
                        }
                        Labelled {
                            label: L.s(L.revision, "expression");
                            label-width: 90px;
                            LineEdit {
                                text <=> root.edit-filter-rule;
                                horizontal-stretch: 1;
                                placeholder-text: L.s(L.revision, "filter_placeholder");
                                edited => { root.filter-rule-changed(self.text); }
                            }
                            // Stands in for the left pane's Browse button:
                            // `visible` only stops it painting, so it still
                            // takes exactly the same space and the two panes
                            // come out the same width.
                            Button {
                                text: L.s(L.revision, "browse");
                                visible: false;
                            }
                        }
                        Text {
                            text: root.filter-valid ? "" : L.s(L.revision, "filter_invalid");
                            color: #f2705f;
                            font-size: 12px;
                            height: 16px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: L.s(L.revision, "delete");
                                enabled: root.filter-index >= 0;
                                clicked => { root.delete-filter(); }
                            }
                            Button {
                                text: L.s(L.revision, "save");
                                primary: true;
                                enabled: root.edit-filter-name != "" && root.filter-valid;
                                clicked => { root.save-filter(); }
                            }
                        }
                    }
                }
            }
        }

        foot := HorizontalLayout {
            spacing: 8px;
            Text {
                text: L.s(L.revision, "changes_applied_on_ok");
                font-size: 12px;
                color: Palette.foreground;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: L.s(L.revision, "cancel"); clicked => { root.cancelled(); } }
            Button { text: L.s(L.revision, "ok"); primary: true; clicked => { root.accepted(); } }
        }
    }
}
