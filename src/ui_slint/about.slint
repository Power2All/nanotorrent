// The About box: version, build stamp and a link to the project site.

import { Button, Palette } from "std-widgets.slint";
import { L } from "globals.slint";

export component AboutDialog inherits Window {
    icon: @image-url("../../res/app.png");
    title: L.s(L.revision, "about_nanotorrent");
    // Width is pinned - nothing here reflows horizontally. Height is NOT:
    // the window takes its content's natural height, so it opens exactly
    // fitting and shows no scrollbar. Capping it instead meant a cap even a
    // few pixels under the content left the scrollbar up permanently.
    // min-height only sets how far it may be dragged down on a screen too
    // short for it - that is when the ScrollView earns its keep.
    min-width: 400px;
    max-width: 400px;
    min-height: 200px;
    background: Palette.background;

    in property <string> version;
    in property <string> build-stamp;
    in property <string> website;
    in property <string> developer;

    callback open-website();
    callback open-developer();
    callback closed();

    VerticalLayout {
        padding: 20px;
        spacing: 8px;

        Text {
            text: "NanoTorrent";
            font-size: 26px;
            font-weight: 700;
            color: Palette.foreground;
        }
        Text {
            text: L.s(L.revision, "version") + " " + root.version;
            font-size: 13px;
            color: Palette.foreground;
        }
        Text {
            text: L.s(L.revision, "build") + " " + root.build-stamp;
            font-size: 12px;
            color: #888;
        }

        Rectangle { height: 6px; }

        Text {
            text: L.s(L.revision, "app_description");
            font-size: 13px;
            color: Palette.foreground;
        }

        // Styled as a link and clickable. Slint has no hyperlink widget, so
        // this is a TouchArea over coloured text - which is all the Win32
        // dialog does too.
        TouchArea {
            height: 22px;
            mouse-cursor: pointer;
            clicked => { root.open-website(); }
            Text {
                text: root.website;
                font-size: 13px;
                color: Palette.accent-background;
                vertical-alignment: center;
                // The TouchArea is full width, so without this the link
                // centres itself while everything above is left-aligned.
                horizontal-alignment: left;
                width: parent.width;
            }
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: L.s(L.revision, "app_credit");
            font-size: 12px;
            color: #888;
        }

        // "Developed by <name>", the name being the clickable half. Two Texts
        // in a row rather than one, because only the name is a link and Slint
        // has no rich text.
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Text {
                text: L.s(L.revision, "developed_by");
                font-size: 12px;
                color: #888;
                vertical-alignment: center;
            }
            TouchArea {
                width: link-text.preferred-width;
                height: 18px;
                mouse-cursor: pointer;
                clicked => { root.open-developer(); }
                link-text := Text {
                    text: root.developer;
                    font-size: 12px;
                    color: Palette.accent-background;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: L.s(L.revision, "close");
                primary: true;
                clicked => { root.closed(); }
            }
        }
    }
}
