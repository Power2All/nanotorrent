// The About box: version, build stamp and a link to the project site.

import { ScrollView, Button, Palette } from "std-widgets.slint";
import { L } from "globals.slint";

export component AboutDialog inherits Window {
    icon: @image-url("../../res/app-256.png");
    title: L.s(L.revision, "about_nanotorrent");
    // Width is pinned - nothing here reflows horizontally. Height is NOT:
    // the window takes its content's natural height, so it opens exactly
    // fitting and shows no scrollbar. Capping it instead meant a cap even a
    // few pixels under the content left the scrollbar up permanently.
    // min-height only sets how far it may be dragged down on a screen too
    // short for it - that is when the ScrollView earns its keep.
    min-width: 400px;
    max-width: 400px;
    // min == max, both bound to the limit: binding only max leaves an
    // already-shown window at its old height, because nothing forces a
    // re-layout. This is the shape the Preferences dialog uses.
    min-height: min(body.preferred-height, root.screen-limit);
    /// The tallest this window may be, in logical pixels - set from the
    /// monitor work area. Huge by default so a build that cannot read it
    /// behaves as if unclamped.
    in property <length> screen-limit: 100000px;
    max-height: min(body.preferred-height, root.screen-limit);
    background: Palette.background;

    in property <string> version;
    in property <string> build-stamp;
    in property <string> website;
    in property <string> developer;

    callback open-website();
    callback open-developer();
    callback closed();

    // Scrolls rather than clipping when the clamp above wins on a
    // screen too short for the content.
    ScrollView {
        vertical-scrollbar-policy: as-needed;
        body := VerticalLayout {
            padding: 20px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                // `about-logo.png`, NOT `app-256.png`, even though the two
                // are the same picture at the same size.
                //
                // This window's `icon` above is `app-256.png`. Binding one
                // image file to a window icon AND drawing it inside that same
                // window costs every window opened afterwards its icon: the
                // title bar falls back to the generic Windows one. Open About,
                // close it, open it again and the second one has no icon - and
                // from then on neither does Preferences, nor a plugin window.
                // Drawing a separate file keeps the icon binding untouched.
                //
                // The 256px derivative rather than the 2048px master: this is
                // drawn at 64, and the master exists for the Store's scaling.
                // See res/README.md, which says to regenerate both together.
                //
                // A fixed square rather than a stretched one - the layout
                // would otherwise give it whatever height the text block
                // came to, and a 26px title plus two small lines is not
                // square.
                Image {
                    source: @image-url("../../res/about-logo.png");
                    width: 64px;
                    height: 64px;
                    image-fit: contain;
                }

                // Its own layout with tighter spacing than the 8px outside:
                // these three lines are one block about the build, and at
                // 8px apart they read as three separate things standing next
                // to a picture.
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "NanoTorrent";
                        font-size: 26px;
                        font-weight: 700;
                        color: Palette.foreground;
                    }
                    Text {
                        text: L.s(L.revision, "version") + " " + root.version;
                        font-size: 13px;
                        color: Palette.foreground;
                    }
                    Text {
                        text: L.s(L.revision, "build") + " " + root.build-stamp;
                        font-size: 12px;
                        color: #888;
                    }
                }
            }

            Rectangle { height: 6px; }

            Text {
                text: L.s(L.revision, "app_description");
                font-size: 13px;
                color: Palette.foreground;
            }

            // Styled as a link and clickable. Slint has no hyperlink widget, so
            // this is a TouchArea over coloured text - which is all the Win32
            // dialog does too.
            TouchArea {
                height: 22px;
                mouse-cursor: pointer;
                clicked => { root.open-website(); }
                Text {
                    text: root.website;
                    font-size: 13px;
                    color: Palette.accent-background;
                    vertical-alignment: center;
                    // The TouchArea is full width, so without this the link
                    // centres itself while everything above is left-aligned.
                    horizontal-alignment: left;
                    width: parent.width;
                }
            }

            Rectangle { vertical-stretch: 1; }

            Text {
                text: L.s(L.revision, "app_credit");
                font-size: 12px;
                color: #888;
            }

            // "Developed by <name>", the name being the clickable half. Two Texts
            // in a row rather than one, because only the name is a link and Slint
            // has no rich text.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text {
                    text: L.s(L.revision, "developed_by");
                    font-size: 12px;
                    color: #888;
                    vertical-alignment: center;
                }
                TouchArea {
                    width: link-text.preferred-width;
                    height: 18px;
                    mouse-cursor: pointer;
                    clicked => { root.open-developer(); }
                    link-text := Text {
                        text: root.developer;
                        font-size: 12px;
                        color: Palette.accent-background;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: L.s(L.revision, "close");
                    primary: true;
                    clicked => { root.closed(); }
                }
            }
        }
    }
}
