// The tab strip shared by the details panel and the Preferences dialog.
//
// Slint's own TabWidget stretches its tabs across the full width and has no
// room for an icon, which is why the details panel stopped using it. Preferences
// now uses the same strip, so the two read as one application rather than two
// that happen to ship together.

import { Palette, ScrollView } from "std-widgets.slint";

// One tab: an icon (passed as a child), a caption, and an underline when it is
// the current one.
export component DetailTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    // Sized to its content, not to a share of the width.
    horizontal-stretch: 0;
    height: 28px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    background: root.selected ? Palette.background
        : tab-touch.has-hover ? Palette.alternate-background : transparent;

    // Mixed toward the background rather than a fixed grey: an unselected tab
    // has to read as available-but-not-current on BOTH palettes, and #8a8a8a
    // against the light background looked disabled.
    //
    // Weighted heavily toward the foreground (0.85, not 0.65) because at the
    // lower value it still read as disabled: ~#6a6a6a on white and ~#8a8a8a on
    // near-black. What separates the current tab is the accent icon, the bold
    // label and the underline - it does not also need the others to be faint.
    out property <color> muted: Palette.foreground.mix(Palette.background, 0.85);
    out property <color> ink: root.selected ? Palette.accent-background : root.muted;

    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        VerticalLayout { alignment: center; @children }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.selected ? 700 : 400;
            vertical-alignment: center;
            color: root.selected ? Palette.foreground : root.muted;
        }
    }

    // The selected tab joins the panel below it.
    if root.selected: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Palette.accent-background;
    }
}

// A row of tabs that scrolls sideways when it does not fit.
//
// Seven tabs with icons fit an English Preferences window; they do not fit
// every translation of it, and a tab you cannot reach is a setting you cannot
// change. Rather than size every window to its longest language, the strip
// scrolls.
//
// The height grows when a scrollbar appears: a ScrollView draws its bar inside
// its own bounds, and at the fixed height that bar sits exactly on the selected
// tab's underline. Compared against `visible-width` rather than the parent's
// width, which would make the height depend on something that depends on it.
export component TabStrip inherits Rectangle {
    // The 6px tolerance is the strip's own left padding: without it a row
    // that fits to the pixel still reports a hair of overflow, and the
    // window grew to make room for a scrollbar with nothing to scroll.
    // Losing up to 6px of the last tab's right padding is not losing
    // anything.
    out property <bool> scrolls: sv.content-width > sv.visible-width + 6px;

    // Room BELOW the tabs for the scrollbar, which a ScrollView draws inside
    // its own bounds - over whatever is at that edge, and what sits there is
    // the selected tab's underline.
    //
    // The room is empty space under the row, NOT padding on the row: padding
    // feeds into the layout info that `content-width` reads, and Slint
    // rejected that as a binding loop (bar-room -> padding -> min-width ->
    // content-width -> scrolls -> bar-room).
    out property <length> bar-room: root.scrolls ? 20px : 0px;

    // min == max, NOT `height`. This sits in a VerticalLayout, and a layout
    // assigns its children's geometry: an explicit height competes with the
    // layout instead of constraining it, so the reserved room collapsed and
    // the scrollbar was drawn straight through the tab captions.
    min-height: 30px + root.bar-room;
    max-height: 30px + root.bar-room;

    // The wheel scrolls the row sideways. This strip only ever scrolls
    // horizontally, and the wheel most mice have only sends VERTICAL deltas -
    // so without this the wheel does nothing over a row that visibly has more
    // tabs off the edge, which reads as broken rather than as unsupported.
    //
    // The TouchArea is the ScrollView's PARENT, not a sibling behind it:
    // Slint delivers an event to the innermost element and bubbles it up the
    // parent chain, so a sibling underneath would never see it. As a parent it
    // gets what the tabs themselves do not handle, and the tabs still get their
    // clicks because children sit above it.
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        scroll-event(event) => {
            if (!root.scrolls) {
                // Nothing to scroll: let the wheel go to whatever is behind,
                // rather than swallowing it over a row that fits.
                return EventResult.reject;
            }
            // A tilt wheel or a trackpad gives delta-x directly; a plain wheel
            // gives delta-y and means the same thing here.
            sv.content-x = clamp(
                sv.content-x + (event.delta-x != 0 ? event.delta-x : event.delta-y),
                // content-x runs from 0 (leftmost) down to a negative number,
                // so the LOWER bound is the negative one.
                min(0px, sv.visible-width - sv.content-width),
                0px);
            return EventResult.accept;
        }

        sv := ScrollView {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            vertical-scrollbar-policy: always-off;
            content-width: inner.preferred-width;

            // Holds the row at the top; whatever is left over is where the bar
            // draws.
            VerticalLayout {
                alignment: start;
                inner := HorizontalLayout {
                    alignment: start;
                    padding-left: 6px;
                    padding-top: 1px;
                    spacing: 2px;
                    @children
                }
            }
        }
    }
}

// --- Preferences tab icons --------------------------------------------------
//
// One 20x20 viewbox drawn at 16px, matching the details panel's set. Filled
// polygons rather than strokes: a stroked path at this size renders a
// different weight on each platform, and these sit next to text that does not.

/// A filled glyph on a square viewbox - 20 units unless it says otherwise -
/// drawn at `size`: every icon below, the status bar's and most of the
/// toolbar's. `d` is the path - straight-line polygons only, for the reason
/// IconButton gives: no dependence on SVG arc support.
export component PathIcon inherits Rectangle {
    in property <color> ink;
    in property <string> d;
    in property <length> size: 16px;
    in property <float> viewbox: 20;
    width: root.size;
    height: root.size;
    Path {
        x: 0; y: 0; width: parent.width; height: parent.height;
        viewbox-width: root.viewbox; viewbox-height: root.viewbox;
        fill: root.ink;
        commands: root.d;
    }
}

// A cog, for the toolbar's Preferences and a plugin's Configure. A solid cog,
// hub and all. The hub used to be punched out in the colour behind it, which
// only works while that colour is known - the button is transparent until
// hovered, so the punch did nothing and the deep teeth left it reading as an
// asterisk. Shallower teeth and no hole is the shape that survives being 16px
// tall.
export component GearIcon inherits PathIcon {
    viewbox: 24;
    d: "M 22.67 9.34 L 22.67 14.66 L 20.18 14.66 L 19.66 15.90 L 21.43 17.67 L 17.67 21.43 L 15.90 19.66 L 14.66 20.18 L 14.66 22.67 L 9.34 22.67 L 9.34 20.18 L 8.10 19.66 L 6.33 21.43 L 2.57 17.67 L 4.34 15.90 L 3.82 14.66 L 1.33 14.66 L 1.33 9.34 L 3.82 9.34 L 4.34 8.10 L 2.57 6.33 L 6.33 2.57 L 8.10 4.34 L 9.34 3.82 L 9.34 1.33 L 14.66 1.33 L 14.66 3.82 L 15.90 4.34 L 17.67 2.57 L 21.43 6.33 L 19.66 8.10 L 20.18 9.34 Z";
}

// Sliders, for General.
export component GeneralIcon inherits PathIcon {
    d: "M 2 4 L 18 4 L 18 6 L 2 6 Z M 2 9 L 18 9 L 18 11 L 2 11 Z M 2 14 L 18 14 L 18 16 L 2 16 Z M 12 2 L 16 2 L 16 8 L 12 8 Z M 5 7 L 9 7 L 9 13 L 5 13 Z M 12 12 L 16 12 L 16 18 L 12 18 Z";
}

// An arrow into a tray, for Downloads.
export component DownloadsIcon inherits PathIcon {
    d: "M 8 2 L 12 2 L 12 9 L 16 9 L 10 15 L 4 9 L 8 9 Z M 2 16 L 18 16 L 18 18 L 2 18 Z";
}

// Two links of a chain, for Connection.
export component ConnectionIcon inherits PathIcon {
    d: "M 1 6 L 9 6 L 9 9 L 4 9 L 4 11 L 9 11 L 9 14 L 1 14 Z M 11 6 L 19 6 L 19 14 L 11 14 L 11 11 L 16 11 L 16 9 L 11 9 Z";
}

// A stack of servers, for Proxy - the same shape the status bar uses.
export component ProxyTabIcon inherits PathIcon {
    d: "M 2 2 L 18 2 L 18 6 L 2 6 Z M 2 8 L 18 8 L 18 12 L 2 12 Z M 2 14 L 18 14 L 18 18 L 2 18 Z";
}

// A screen on a stand, for the web interface.
export component WebTabIcon inherits PathIcon {
    d: "M 1 3 L 19 3 L 19 14 L 1 14 Z M 3 5 L 3 12 L 17 12 L 17 5 Z M 7 16 L 13 16 L 13 18 L 7 18 Z";
}

// A piece that interlocks, for Plugins.
export component PluginsIcon inherits PathIcon {
    d: "M 3 3 L 12 3 L 12 6 L 16 6 L 16 11 L 12 11 L 12 17 L 3 17 Z";
}

// A speedometer needle, for Speed. A wedge and a pointer rather than a dial:
// an arc at 16px reads as a smudge.
export component SpeedIcon inherits PathIcon {
    d: "M 2 15 L 4 9 L 7 6 L 13 6 L 16 9 L 18 15 L 15 15 L 13 10 L 7 10 L 5 15 Z M 9 15 L 14 11 L 15 12 L 11 16 Z";
}

// Stacked bars of decreasing width, for the queue: a list with an order.
export component QueueIcon inherits PathIcon {
    d: "M 2 3 L 18 3 L 18 6 L 2 6 Z M 2 8 L 14 8 L 14 11 L 2 11 Z M 2 13 L 10 13 L 10 16 L 2 16 Z";
}

// A padlock, for Database - the tab is about encrypting it, and a lock says
// that where a cylinder would only repeat the word.
export component DatabaseIcon inherits PathIcon {
    d: "M 4 9 L 16 9 L 16 18 L 4 18 Z M 6 9 L 6 6 L 8 4 L 12 4 L 14 6 L 14 9 L 12 9 L 12 6.5 L 11 5.5 L 9 5.5 L 8 6.5 L 8 9 Z";
}

// A funnel, for Labels and filters.
export component LabelsIcon inherits PathIcon {
    d: "M 2 3 L 18 3 L 12 10 L 12 17 L 8 15 L 8 10 Z";
}
