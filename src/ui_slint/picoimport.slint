// Confirming an import from PicoTorrent.
//
// One dialog rather than three prompts in a row: importing can add hundreds of
// torrents, and with the first box ticked it also takes away everything already
// here. Both choices sit next to the button that acts on them, where they can
// be read together.
//
// The purge is deliberately NOT the default. It is the destructive half, and a
// box that arrives ticked is one nobody reads.

import { ScrollView, Button, CheckBox, Palette } from "std-widgets.slint";
import { L } from "globals.slint";

export component PicoImportDialog inherits Window {
    icon: @image-url("../../res/app-256.png");
    // Set from Rust: the title names the client, and `L.s` passes no
    // arguments - bound to the key directly it showed "Import from {0}...".
    title: root.window-title;
    in property <string> window-title;

    min-width: 520px;
    max-width: 520px;
    min-height: min(body.preferred-height, root.screen-limit);
    /// The tallest this window may be, in logical pixels - set from the
    /// monitor work area. Huge by default so a build that cannot read it
    /// behaves as if unclamped.
    in property <length> screen-limit: 100000px;
    max-height: min(body.preferred-height, root.screen-limit);
    background: Palette.background;

    /// The two captions that name the other client. Set from Rust rather than
    /// looked up here: the name is an ARGUMENT, so the translations never carry
    /// it - that is what keeps the rebranding guard honest, and it is how
    /// `import_from_app` has always worked.
    in property <string> ask-text;
    in property <string> settings-text;
    /// Whether this client's settings can be read into this build's schema.
    /// Only PicoTorrent's can; the others keep their preferences in formats
    /// whose keys mean different things, so the box is hidden rather than
    /// offered and quietly ignored.
    in property <bool> can-settings: true;
    /// The warning that purging cannot be undone by Cancel. Built in Rust so
    /// it can stay one sentence in the translations.
    in property <string> purge-warning;
    /// The settings box lives inside an `if`, and an element in a conditional
    /// cannot be reached by id from outside it - so its state lives here.
    in-out property <bool> settings-checked: false;

    /// `(purge, settings)` - what was ticked when Import was pressed.
    callback confirmed(bool, bool);
    callback cancelled();

    // Esc cancels, as in every other dialog here. No Enter binding: Import is
    // not something a stray keypress should reach.
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    ScrollView {
        vertical-scrollbar-policy: as-needed;
        body := VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Text {
                text: root.ask-text;
                font-size: 13px;
                font-weight: 700;
                color: Palette.foreground;
                wrap: word-wrap;
            }

            purge := CheckBox {
                text: L.s(L.revision, "pico_import_purge");
                checked: false;
            }

            if root.can-settings: CheckBox {
                text: root.settings-text;
                checked <=> root.settings-checked;
            }

            // Shown only when the destructive box is ticked: a warning that is
            // always on screen is one nobody reads by the time it matters.
            if purge.checked && root.purge-warning != "": Text {
                text: root.purge-warning;
                font-size: 12px;
                color: #c08040;
                wrap: word-wrap;
            }

            Text {
                text: L.s(L.revision, "pico_import_skips");
                font-size: 12px;
                color: #888;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: L.s(L.revision, "cancel");
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: L.s(L.revision, "pico_import_go");
                    primary: true;
                    clicked => { root.confirmed(purge.checked, root.can-settings && root.settings-checked); }
                }
            }
        }
    }
}
