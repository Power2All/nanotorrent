# Everything here is produced by build.sh and regenerates on demand.

# flatpak-builder's cache and output. The cache reaches several GB.
.flatpak-builder/
build-dir/
repo/

# Downloaded by build.sh. Deliberately not vendored: it tracks the format
# flatpak-builder expects, and a stale copy fails in confusing ways.
flatpak-cargo-generator.py

# Generated from Cargo.lock, ~450 KB, and rewritten whenever a dependency
# moves. build.sh regenerates it when Cargo.lock is newer.
#
# NOTE: the Flathub manifest repo does need a committed copy of this - it has
# no Cargo.lock to generate one from. Copy it across when submitting.
cargo-sources.json

# The working-tree manifest build.sh generates for local testing.
local-*.yml
