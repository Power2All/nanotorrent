+    /// BEP 6 `have all` / `have none`: the whole bitfield in one message,
+    /// which a peer may send instead of a bitfield once fast is negotiated.
+    fn on_have_all_or_none(&self, all: bool) {
+        let mut bf = make_piece_bitfield(&self.state.lengths);
+        if all {
+            bf.fill(true);
+        }
+        trace!(all, "peer sent have_all/have_none");
+        self.state.peers.update_bitfield(self.addr, bf);
+        self.on_bitfield_notify.notify_waiters();
+    }
+
+    /// BEP 6 `reject request`: this peer will not serve that chunk. Put the
+    /// piece back in the queue instead of waiting for it to time out.
+    fn on_reject_request(&self, request: Request) {
+        let Some(piece) = self.state.lengths.validate_piece_index(request.index) else {
+            return;
+        };
+        let released = match self.state.lock_write("on_reject_request").get_pieces_mut() {
+            Ok(pieces) => pieces.release_piece_owned_by(self.addr, piece),
+            Err(_) => false,
+        };
+        trace!(?request, released, "peer rejected a request");
+        if released {
+            self.notify_request_slots_changed();
+        }
+    }
