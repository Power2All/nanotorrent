 impl TorrentStateLive {
+    /// NanoTorrent visibility patch (additive, no behavior change): the
+    /// number of pieces each connected (live) peer advertises in its
+    /// bitfield - used by the UI for seed counts and availability.
+    pub fn per_peer_have_pieces(&self) -> Vec<(std::net::SocketAddr, u64)> {
+        self.peers
+            .states
+            .iter()
+            .filter_map(|entry| match entry.value().get_state() {
+                PeerState::Live(live) => Some((*entry.key(), live.bitfield.count_ones() as u64)),
+                _ => None,
+            })
+            .collect()
+    }
