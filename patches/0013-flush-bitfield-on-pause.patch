@@ -723,6 +723,25 @@ impl TorrentStateLive {
         // It should be impossible to make a fatal error after pausing.
         g.fatal_errors_tx.take();
 
+        // Flush the have-bitfield before the tracker leaves this state.
+        //
+        // It is otherwise only written every FLUSH_BITV_EVERY_BYTES and once
+        // on completion, so up to 16 MB of *verified* pieces live only in
+        // dirty mmap pages. A clean exit gets away with it because the kernel
+        // writes the mapping back; a crash, a power loss or a force-kill does
+        // not, and those pieces come back as missing on the next start.
+        //
+        // The data is on disk either way - only the record of having checked
+        // it is lost - so the torrent reappears a few pieces short of done,
+        // with a file that is fully allocated and plays. Re-downloading them
+        // is the good case; a thin swarm that no longer has them means it
+        // never finishes, and a recheck is the only way out.
+        //
+        // Here rather than in `Drop`: pause is also the shutdown path, this is
+        // the last point the tracker is still owned by the live state, and a
+        // failed msync must be logged rather than swallowed by a destructor.
+        g.try_flush_bitv();
+
         let mut chunk_tracker = g
             .chunks
             .take()
