diff --git a/src/lib.rs b/src/lib.rs
index a9aee9f..c63fea3 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -118,6 +118,15 @@ pub const fn client_name_and_version() -> &'static str {
     concat!("rqbit ", env!("CARGO_PKG_VERSION"))
 }
 
+/// The BEP 10 extended-handshake `v` string, if the embedding application has
+/// set one.
+///
+/// librqbit is a library: peers should be told the name of the program they
+/// are actually talking to, not the crate it links. Set once at startup;
+/// unset falls back to [`client_name_and_version`], so upstream behaviour is
+/// unchanged for anyone who never touches it.
+pub static CLIENT_NAME: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+
 pub fn try_increase_nofile_limit() -> anyhow::Result<u64> {
     Ok(rlimit::increase_nofile_limit(1024 * 1024)?)
 }
diff --git a/src/peer_connection.rs b/src/peer_connection.rs
index 4e1eadb..1272e89 100644
--- a/src/peer_connection.rs
+++ b/src/peer_connection.rs
@@ -271,7 +271,15 @@ impl<H: PeerConnectionHandler> PeerConnection<H> {
 
         if supports_extended {
             let mut my_extended = ExtendedHandshake::new();
-            my_extended.v = Some(ByteBuf(crate::client_name_and_version().as_bytes()));
+            // Anonymous mode clears this again in update_my_extended_handshake
+            // below, so there is no fingerprint to leak here.
+            my_extended.v = Some(ByteBuf(
+                crate::CLIENT_NAME
+                    .get()
+                    .map(String::as_str)
+                    .unwrap_or(crate::client_name_and_version())
+                    .as_bytes(),
+            ));
             my_extended.yourip = Some(PeerIP(self.addr.ip()));
             self.handler
                 .update_my_extended_handshake(&mut my_extended)?;
