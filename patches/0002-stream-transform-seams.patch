+use librqbit_core::hash_id::Id20;
+
+/// NanoTorrent seam: a plain (non-vectored) boxed read half. Transforms deal in
+/// this rather than the crate's `BoxAsyncReadVectored` because a cipher layer
+/// has to see one contiguous byte stream anyway; the connector wraps the result
+/// back into a vectored reader with `AsyncReadVectoredIntoCompat`.
+pub type BoxAsyncRead = Box<dyn tokio::io::AsyncRead + Send + Unpin + 'static>;
+
+/// A pluggable transform applied to every outgoing peer stream right after the
+/// TCP/uTP (or proxy) connection is established, before the BitTorrent
+/// handshake. Lets the embedding application wrap connections (e.g. with
+/// protocol encryption) without modifying the engine. `None` (the default)
+/// leaves engine behavior exactly as upstream.
+pub trait StreamTransform: Send + Sync + std::fmt::Debug {
+    fn transform(
+        &self,
+        addr: SocketAddr,
+        info_hash: Id20,
+        read: BoxAsyncRead,
+        write: BoxAsyncWrite,
+    ) -> futures::future::BoxFuture<'_, anyhow::Result<(BoxAsyncRead, BoxAsyncWrite)>>;
+}
+
+/// The incoming counterpart of [`StreamTransform`], applied to every accepted
+/// peer stream before the BitTorrent handshake is read. Unlike the outgoing
+/// side the info-hash is not known yet, so the info-hashes of all active
+/// torrents are passed in for the transform to resolve against (e.g. an MSE
+/// responder matching the peer's SKEY).
+pub trait IncomingStreamTransform: Send + Sync + std::fmt::Debug {
+    fn transform(
+        &self,
+        addr: SocketAddr,
+        info_hashes: Vec<Id20>,
+        read: BoxAsyncRead,
+        write: BoxAsyncWrite,
+    ) -> futures::future::BoxFuture<'_, anyhow::Result<(BoxAsyncRead, BoxAsyncWrite)>>;
+}
 
