+    /// NanoTorrent addition: snapshot of per-tracker announce stats for a
+    /// torrent, as (tracker_url, stats). Empty until the first announce.
+    pub fn tracker_stats_snapshot(
+        &self,
+        info_hash: Id20,
+    ) -> Vec<(String, tracker_comms::TrackerStat)> {
+        let Ok(map) = self.tracker_stats.lock() else {
+            return Vec::new();
+        };
+        let Some(shared) = map.get(&info_hash) else {
+            return Vec::new();
+        };
+        let Ok(stats) = shared.lock() else {
+            return Vec::new();
+        };
+        stats.iter().map(|(k, v)| (k.clone(), v.clone())).collect()
+    }
+
+    /// NanoTorrent addition: announce tiers for a torrent, as tiers of URL
+    /// strings. Empty if unknown (e.g. magnets).
+    pub fn tracker_tiers_snapshot(&self, info_hash: Id20) -> Vec<Vec<String>> {
+        let Ok(map) = self.tracker_tiers.lock() else {
+            return Vec::new();
+        };
+        map.get(&info_hash)
+            .map(|tiers| {
+                tiers
+                    .iter()
+                    .map(|tier| tier.iter().map(|u| u.to_string()).collect())
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
